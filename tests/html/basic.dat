#data
<p>icon <svg viewbox="0 0 9 9" xlink:href="#u"><clippath><circle r=2 /></clippath><foreignobject><div>html</div></foreignobject></svg> after
#errors
#comment SVG in its namespace: the adjusted names, an XLink attribute, a self-closing element, a foreignObject of HTML (Chromium's tree)
#document
| <html>
|   <head>
|   <body>
|     <p>
|       "icon "
|       <svg svg>
|         viewBox="0 0 9 9"
|         xlink href="#u"
|         <svg clipPath>
|           <svg circle>
|             r="2"
|         <svg foreignObject>
|           <div>
|             "html"
|       " after"

#data
<svg><desc><b>bold</b></desc><style>a<b</style><p>breaks out
#errors
#comment an HTML integration point; an SVG style, no raw text; p breaks out of foreign content (Chromium's tree)
#document
| <html>
|   <head>
|   <body>
|     <svg svg>
|       <svg desc>
|         <b>
|           "bold"
|       <svg style>
|         "a"
|         <svg b<>
|           style=""
|     <p>
|       "breaks out"

#data
<math><mi>x</mi><annotation-xml encoding="text/html"><p>p</p></annotation-xml><mtext><i>i</i></mtext><definitionurl definitionurl=u></math>
#errors
#comment MathML: text integration points, an annotation-xml of HTML, definitionURL adjusted (Chromium's tree)
#document
| <html>
|   <head>
|   <body>
|     <math math>
|       <math mi>
|         "x"
|       <math annotation-xml>
|         encoding="text/html"
|         <p>
|           "p"
|       <math mtext>
|         <i>
|           "i"
|       <math definitionurl>
|         definitionURL="u"

