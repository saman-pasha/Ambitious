static void store_html_store_tag__bytes_room(store_html_store_tag *s, size_t n) {
    if (s->bytes_len + n <= s->bytes_cap) return;
    size_t c = s->bytes_cap ? s->bytes_cap : 256;
    while (c < s->bytes_len + n) c *= 2;
    if (c > 0x7FFFFFFF) abort();
    s->bytes = (char *)realloc(s->bytes, c);
    if (!s->bytes) abort();
    s->bytes_cap = c;
}
amb_span store_html_store_tag_bytes_add(store_html_store_tag *s, const char *p, size_t n) {
    amb_span sp = { 0, 0 };
    if (s->bytes_len == 0) {
        store_html_store_tag__bytes_room(s, 1);
        s->bytes[0] = 0;
        s->bytes_len = 1;
    }
    if (n == 0) return sp;
    int inside = p >= s->bytes && p < s->bytes + s->bytes_len;
    size_t from = inside ? (size_t)(p - s->bytes) : 0;
    store_html_store_tag__bytes_room(s, n);
    if (inside) memmove(s->bytes + s->bytes_len, s->bytes + from, n);
    else memcpy(s->bytes + s->bytes_len, p, n);
    sp.off = (uint32_t)s->bytes_len;
    sp.len = (uint32_t)n;
    s->bytes_len += n;
    return sp;
}
const char *store_html_store_tag_bytes_ptr(const store_html_store_tag *s, amb_span sp) tie s {
