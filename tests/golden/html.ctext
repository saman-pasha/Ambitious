uint32_t store_html_store_tag_attributes_up(const store_html_store_tag *s, uint32_t i) { if (i >= s->tattr_len) abort(); return s->tattr[i].token; }

size_t store_html_store_tag_attributes_count(const store_html_store_tag *s, uint32_t o) {
    size_t n = 0;
    if (o >= s->token_len) abort();
    for (uint32_t i = s->token[o].first_attr; i; i = s->tattr[i].next) {
        n++;
        if (n > s->tattr_len) abort();
    }
    return n;
}

