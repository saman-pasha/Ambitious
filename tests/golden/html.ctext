int html_check_invariants(const html_parser *d, FILE *report) {
    int bad = 0;
    /* attr_links */
    {
        own uint32_t *seen = (uint32_t *)calloc(d->tattr_len ? d->tattr_len : 1, sizeof(uint32_t));
        if (!seen) abort();
        for (uint32_t o = 1; o < d->token_len; o++) {
            if (!d->token[o].live) continue;
            uint32_t prev = 0;
            size_t steps = 0;
            for (uint32_t i = d->token[o].first_attr; i; i = d->tattr[i].next) {
                if (i >= d->tattr_len || !d->tattr[i].live || d->tattr[i].token != o || ++steps > d->tattr_len || seen[i]) { bad++; amb_report(report, "html", "attr_links", o); break; }
                seen[i] = o;
                prev = i;
            }
        if (d->token[o].last_attr != prev) { bad++; amb_report(report, "html", "attr_links", o); }
        }
        for (uint32_t i = 1; i < d->tattr_len; i++)
            if (d->tattr[i].live && d->tattr[i].token && seen[i] != d->tattr[i].token) { bad++; amb_report(report, "html", "attr_links", i); }
        free(seen);
    }
    /* live_links */
    {
        for (uint32_t i = 1; i < d->token_len; i++) {
            uint32_t r = d->token[i].first_attr;
            if (d->token[i].live && r && (r >= d->tattr_len || !d->tattr[r].live)) { bad++; amb_report(report, "html", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->token_len; i++) {
            uint32_t r = d->token[i].last_attr;
            if (d->token[i].live && r && (r >= d->tattr_len || !d->tattr[r].live)) { bad++; amb_report(report, "html", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->tattr_len; i++) {
            uint32_t r = d->tattr[i].token;
            if (d->tattr[i].live && r && (r >= d->token_len || !d->token[r].live)) { bad++; amb_report(report, "html", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->tattr_len; i++) {
            uint32_t r = d->tattr[i].next;
            if (d->tattr[i].live && r && (r >= d->tattr_len || !d->tattr[r].live)) { bad++; amb_report(report, "html", "live_links", i); }
        }
    }
    return bad;
}
void html_export(const html_parser *d, FILE *out) {
    fprintf(out, "amb_snapshot(html, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, html_fingerprint);


    for (uint32_t i = 1; i < d->error_len; i++) {
        if (!d->error[i].live) continue;
        if (1) { fputs("html_error(", out); amb_put_handle(out, "err", d->id, i, d->error[i].gen); fputs(",", out); fputs(html_error_code_name(d->error[i].code), out); fputs(",", out); fprintf(out, "%lld", (long long)d->error[i].line); fputs(",", out); fprintf(out, "%lld", (long long)d->error[i].col); fputs(",", out); bytes_put(d, out, d->error[i].detail); fputs(").\n", out); }
    }
}
html_status html_dispatch(html_parser *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    html_status st = HTML_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return HTML_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return HTML_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return HTML_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return HTML_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return HTML_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return HTML_STALE_REVISION; }

    if (amb_name_is(name, name_len, "tokenize") || amb_name_is(name, name_len, "build") || amb_name_is(name, name_len, "parse") || amb_name_is(name, name_len, "parse_fragment")) { amb_result(report, name, "not_requestable", d->revision); return HTML_NOT_REQUESTABLE; }
    amb_result(report, name, "bad_request", d->revision);
    return st;
}
