void store_html_store_tag_attributes_append(store_html_store_tag *s, uint32_t o, uint32_t i) {
    if (o == 0 || i == 0 || o >= s->token_len || i >= s->tattr_len) abort();
    uint32_t t = s->token[o].last_attr;
    s->tattr[i].token = o;
    s->tattr[i].next = 0;
    if (t) s->tattr[t].next = i; else s->token[o].first_attr = i;
    s->token[o].last_attr = i;
}

void store_html_store_tag_attributes_insert_before(store_html_store_tag *s, uint32_t o, uint32_t i, uint32_t b) {
    if (b == 0) { store_html_store_tag_attributes_append(s, o, i); return; }
    if (o == 0 || i == 0 || o >= s->token_len || i >= s->tattr_len || b >= s->tattr_len || s->tattr[b].token != o) abort();
    uint32_t p = 0;
    for (uint32_t x = s->token[o].first_attr; x && x != b; x = s->tattr[x].next) p = x;
    s->tattr[i].token = o;
    s->tattr[i].next = b;
    if (p) s->tattr[p].next = i; else s->token[o].first_attr = i;
}

void store_html_store_tag_attributes_unlink(store_html_store_tag *s, uint32_t i) {
    if (i == 0 || i >= s->tattr_len) abort();
    uint32_t o = s->tattr[i].token;
    if (o == 0) return;
    if (o >= s->token_len) abort();
    uint32_t n = s->tattr[i].next;
    uint32_t p = 0;
    for (uint32_t x = s->token[o].first_attr; x && x != i; x = s->tattr[x].next) p = x;
    if (p) s->tattr[p].next = n; else s->token[o].first_attr = n;
    if (s->token[o].last_attr == i) s->token[o].last_attr = p;
    s->tattr[i].token = 0;
    s->tattr[i].next = 0;
}

