net_status net_check_fetch_subresources(const net_loader *d, dom_document *doc, net_resource_h page, uint32_t denied)
{
    if (!resource_live(d, page)) return NET_STALE_HANDLE;
    return NET_OK;
}

int net_check_invariants(const net_loader *d, FILE *report) {
    int bad = 0;
    /* live_links */
    {
        for (uint32_t i = 1; i < d->resource_len; i++) {
            uint32_t r = d->resource[i].from;
            if (d->resource[i].live && r && (r >= d->resource_len || !d->resource[r].live)) { bad++; amb_report(report, "net", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->hop_len; i++) {
            uint32_t r = d->hop[i].resource;
            if (d->hop[i].live && r && (r >= d->resource_len || !d->resource[r].live)) { bad++; amb_report(report, "net", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->cookie_len; i++) {
            uint32_t r = d->cookie[i].set_by;
            if (d->cookie[i].live && r && (r >= d->resource_len || !d->resource[r].live)) { bad++; amb_report(report, "net", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->sent_len; i++) {
            uint32_t r = d->sent[i].resource;
            if (d->sent[i].live && r && (r >= d->resource_len || !d->resource[r].live)) { bad++; amb_report(report, "net", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->sent_len; i++) {
            uint32_t r = d->sent[i].cookie;
            if (d->sent[i].live && r && (r >= d->cookie_len || !d->cookie[r].live)) { bad++; amb_report(report, "net", "live_links", i); }
        }
    }
    return bad;
}
void net_export(const net_loader *d, FILE *out) {
    fprintf(out, "amb_snapshot(net, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, net_fingerprint);
    for (uint32_t i = 1; i < d->resource_len; i++) {
        if (!d->resource[i].live) continue;
        if (1) { fputs("net_resource(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].url); fputs(",", out); fputs(net_kind_name(d->resource[i].kind), out); fputs(",", out); fputs(net_outcome_name(d->resource[i].outcome), out); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].status); fputs(",", out); text_put(d, out, d->resource[i].type); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].size); fputs(").\n", out); }
        if (1) { fputs("net_final_url(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].final_url); fputs(").\n", out); }
        if (1) { fputs("net_origin(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].origin); fputs(").\n", out); }
        if (d->resource[i].from != 0) { fputs("net_asked_by(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); { uint32_t r = d->resource[i].from; amb_put_ref(out, "rs", d->id, r, r && r < d->resource_len ? d->resource[r].gen : 0); } fputs(",", out); amb_put_ref(out, "n", d->resource[i].elem.doc, d->resource[i].elem.index, d->resource[i].elem.gen); fputs(").\n", out); }
        if (d->resource[i].kind == NET_KIND_IMAGE) { fputs("net_image_size(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].width); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].height); fputs(").\n", out); }
        if (d->resource[i].outcome != NET_OUTCOME_OK) { fputs("net_failure(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].reason); fputs(").\n", out); }
        if (d->resource[i].tls == 1) { fputs("net_tls(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].tls_version); fputs(",", out); text_put(d, out, d->resource[i].tls_cipher); fputs(",", out); text_put(d, out, d->resource[i].alpn); fputs(").\n", out); }
        if (d->resource[i].protocol != NET_PROTOCOL_UNSENT) { fputs("net_http(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); fputs(net_protocol_name(d->resource[i].protocol), out); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].connection); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].stream); fputs(",", out); fputs(d->resource[i].reused ? "true" : "false", out); fputs(").\n", out); }
        if (d->resource[i].proxied == 1) { fputs("net_proxy(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].proxy); fputs(").\n", out); }
        if (d->resource[i].cross_site == 1) { fputs("net_cross_site(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(").\n", out); }
        if (d->resource[i].cache != NET_CACHE_USE_UNUSED) { fputs("net_cache(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); fputs(net_cache_use_name(d->resource[i].cache), out); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].cache_age); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].cache_lifetime); fputs(").\n", out); }
        if (d->resource[i].coded == 1) { fputs("net_coding(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].coding); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].encoded_size); fputs(").\n", out); }
        if (d->resource[i].srcset == 1) { fputs("net_srcset(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); text_put(d, out, d->resource[i].descriptor); fputs(",", out); amb_put_f64(out, d->resource[i].density); fputs(",", out); amb_put_f64(out, d->resource[i].source_size); fputs(",", out); fprintf(out, "%lld", (long long)d->resource[i].candidates); fputs(").\n", out); }
        if (d->resource[i].picture == 1) { fputs("net_picture_source(", out); amb_put_handle(out, "rs", d->id, i, d->resource[i].gen); fputs(",", out); amb_put_ref(out, "n", d->resource[i].source.doc, d->resource[i].source.index, d->resource[i].source.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->hop_len; i++) {
        if (!d->hop[i].live) continue;
        if (1) { fputs("net_hop(", out); { uint32_t r = d->hop[i].resource; amb_put_ref(out, "rs", d->id, r, r && r < d->resource_len ? d->resource[r].gen : 0); } fputs(",", out); text_put(d, out, d->hop[i].url); fputs(",", out); fprintf(out, "%lld", (long long)d->hop[i].status); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->cookie_len; i++) {
        if (!d->cookie[i].live) continue;
        if (d->cookie[i].seen == 1) { fputs("net_cookie(", out); amb_put_handle(out, "ck", d->id, i, d->cookie[i].gen); fputs(",", out); text_put(d, out, d->cookie[i].name); fputs(",", out); text_put(d, out, d->cookie[i].domain); fputs(",", out); text_put(d, out, d->cookie[i].path); fputs(",", out); fputs(net_cookie_state_name(d->cookie[i].state), out); fputs(").\n", out); }
        if (d->cookie[i].seen == 1) { fputs("net_cookie_flags(", out); amb_put_handle(out, "ck", d->id, i, d->cookie[i].gen); fputs(",", out); fputs(d->cookie[i].host_only ? "true" : "false", out); fputs(",", out); fputs(d->cookie[i].secure ? "true" : "false", out); fputs(",", out); fputs(d->cookie[i].http_only ? "true" : "false", out); fputs(",", out); fputs(net_same_site_name(d->cookie[i].same_site), out); fputs(").\n", out); }
        if ((d->cookie[i].seen == 1) && (d->cookie[i].persistent == 1)) { fputs("net_cookie_expires(", out); amb_put_handle(out, "ck", d->id, i, d->cookie[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->cookie[i].expires); fputs(").\n", out); }
        if (d->cookie[i].set_by != 0) { fputs("net_cookie_set_by(", out); amb_put_handle(out, "ck", d->id, i, d->cookie[i].gen); fputs(",", out); { uint32_t r = d->cookie[i].set_by; amb_put_ref(out, "rs", d->id, r, r && r < d->resource_len ? d->resource[r].gen : 0); } fputs(").\n", out); }
        if (d->cookie[i].state == NET_COOKIE_STATE_REFUSED) { fputs("net_cookie_refused(", out); amb_put_handle(out, "ck", d->id, i, d->cookie[i].gen); fputs(",", out); fputs(net_refusal_name(d->cookie[i].refusal), out); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->sent_len; i++) {
        if (!d->sent[i].live) continue;
        if (1) { fputs("net_cookie_sent(", out); { uint32_t r = d->sent[i].resource; amb_put_ref(out, "rs", d->id, r, r && r < d->resource_len ? d->resource[r].gen : 0); } fputs(",", out); { uint32_t r = d->sent[i].cookie; amb_put_ref(out, "ck", d->id, r, r && r < d->cookie_len ? d->cookie[r].gen : 0); } fputs(").\n", out); }
    }

}
net_status net_dispatch(net_loader *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    net_status st = NET_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return NET_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return NET_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return NET_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return NET_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return NET_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return NET_STALE_REVISION; }

    if (amb_name_is(name, name_len, "keep") || amb_name_is(name, name_len, "fetch") || amb_name_is(name, name_len, "fetch_subresources")) { amb_result(report, name, "not_requestable", d->revision); return NET_NOT_REQUESTABLE; }
    amb_result(report, name, "bad_request", d->revision);
    return st;
}
/* the store of module net, an instance of store<net_store_tag>: one own buffer a part */
typedef struct store_net_store_tag {
    uint32_t id;
    uint64_t revision;
    size_t resource_len, resource_cap;
    uint32_t resource_free;
    own net_resource *resource;
    size_t hop_len, hop_cap;
    uint32_t hop_free;
    own net_hop *hop;
    size_t cookie_len, cookie_cap;
    uint32_t cookie_free;
    own net_cookie *cookie;
    size_t sent_len, sent_cap;
    uint32_t sent_free;
    own net_sent *sent;
    size_t keeping_len, keeping_cap;
    uint32_t keeping_free;
    own net_keeping *keeping;
    size_t text_len, text_cap;
    own char *text;
    size_t bytes_len, bytes_cap;
