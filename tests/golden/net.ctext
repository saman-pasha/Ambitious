    switch (x) {
    case NET_OUTCOME_OK: return "ok";
    case NET_OUTCOME_HTTP_ERROR: return "http_error";
    case NET_OUTCOME_NO_SUCH_FILE: return "no_such_file";
    case NET_OUTCOME_REFUSED: return "refused";
    case NET_OUTCOME_UNREACHABLE: return "unreachable";
    case NET_OUTCOME_TOO_MANY_REDIRECTS: return "too_many_redirects";
    case NET_OUTCOME_UNSUPPORTED_SCHEME: return "unsupported_scheme";
    case NET_OUTCOME_BAD_URL: return "bad_url";
    case NET_OUTCOME_BLOCKED: return "blocked";
    case NET_OUTCOME_TOO_LARGE: return "too_large";
    case NET_OUTCOME_MALFORMED: return "malformed";
    case NET_OUTCOME_TLS_HANDSHAKE_FAILED: return "tls_handshake_failed";
