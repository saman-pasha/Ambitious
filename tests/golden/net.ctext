const char *net_status_name(net_status x) {
    switch (x) {
    case NET_OK: return "ok";
    case NET_STALE_HANDLE: return "stale_handle";
    case NET_WRONG_KIND: return "wrong_kind";
    case NET_FAILED: return "failed";
    case NET_BAD_REQUEST: return "bad_request";
    case NET_NOT_REQUESTABLE: return "not_requestable";
    case NET_STALE_REVISION: return "stale_revision";
    }
    return "?";
}
const char *net_op_name(net_op x) {
    switch (x) {
    case NET_OP_FETCH: return "fetch";
    case NET_OP_FETCH_SUBRESOURCES: return "fetch_subresources";
    }
    return "?";
}
