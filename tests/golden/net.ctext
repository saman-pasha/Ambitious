void net_init(net_loader *d, uint32_t id) {
    if (d->resource_len != 0) abort();
    d->id = id;
    d->revision = 0;
    text_add(d, "", 0);
    bytes_add(d, "", 0);
}
uint64_t net_revision(const net_loader *d) { return d->revision; }
