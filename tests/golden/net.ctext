    switch (x) {
    case NET_KIND_DOCUMENT: return "document";
    case NET_KIND_STYLESHEET: return "stylesheet";
    case NET_KIND_IMAGE: return "image";
    case NET_KIND_SCRIPT: return "script";
    case NET_KIND_OTHER: return "other";
    }
    return "?";
}
