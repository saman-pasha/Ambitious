    if (o == 0 || i == 0 || o >= s->sheet_len || i >= s->rule_len || b >= s->rule_len || s->rule[b].sheet != o) abort();
    uint32_t p = 0;
    for (uint32_t x = s->sheet[o].first_rule; x && x != b; x = s->rule[x].next) p = x;
    s->rule[i].sheet = o;
    s->rule[i].next = b;
    if (p) s->rule[p].next = i; else s->sheet[o].first_rule = i;
}

void store_css_store_tag_rules_unlink(store_css_store_tag *s, uint32_t i) {
    if (i == 0 || i >= s->rule_len) abort();
    uint32_t o = s->rule[i].sheet;
    if (o == 0) return;
    if (o >= s->sheet_len) abort();
    uint32_t n = s->rule[i].next;
    uint32_t p = 0;
    for (uint32_t x = s->sheet[o].first_rule; x && x != i; x = s->rule[x].next) p = x;
    if (p) s->rule[p].next = n; else s->sheet[o].first_rule = n;
    if (s->sheet[o].last_rule == i) s->sheet[o].last_rule = p;
    s->rule[i].sheet = 0;
    s->rule[i].next = 0;
}

uint32_t store_css_store_tag_rules_first(const store_css_store_tag *s, uint32_t o) { if (o >= s->sheet_len) abort(); return s->sheet[o].first_rule; }

uint32_t store_css_store_tag_rules_next(const store_css_store_tag *s, uint32_t i) { if (i >= s->rule_len) abort(); return s->rule[i].next; }

uint32_t store_css_store_tag_rules_up(const store_css_store_tag *s, uint32_t i) { if (i >= s->rule_len) abort(); return s->rule[i].sheet; }

size_t store_css_store_tag_rules_count(const store_css_store_tag *s, uint32_t o) {
    size_t n = 0;
    if (o >= s->sheet_len) abort();
    for (uint32_t i = s->sheet[o].first_rule; i; i = s->rule[i].next) {
        n++;
        if (n > s->rule_len) abort();
    }
    return n;
}

void store_css_store_tag_decls_append(store_css_store_tag *s, uint32_t o, uint32_t i) {
    if (o == 0 || i == 0 || o >= s->rule_len || i >= s->decl_len) abort();
    uint32_t t = s->rule[o].last_decl;
    s->decl[i].rule = o;
    s->decl[i].next = 0;
    if (t) s->decl[t].next = i; else s->rule[o].first_decl = i;
    s->rule[o].last_decl = i;
}

void store_css_store_tag_decls_insert_before(store_css_store_tag *s, uint32_t o, uint32_t i, uint32_t b) {
    if (b == 0) { store_css_store_tag_decls_append(s, o, i); return; }
    if (o == 0 || i == 0 || o >= s->rule_len || i >= s->decl_len || b >= s->decl_len || s->decl[b].rule != o) abort();
    uint32_t p = 0;
    for (uint32_t x = s->rule[o].first_decl; x && x != b; x = s->decl[x].next) p = x;
    s->decl[i].rule = o;
    s->decl[i].next = b;
    if (p) s->decl[p].next = i; else s->rule[o].first_decl = i;
}

void store_css_store_tag_decls_unlink(store_css_store_tag *s, uint32_t i) {
    if (i == 0 || i >= s->decl_len) abort();
    uint32_t o = s->decl[i].rule;
    if (o == 0) return;
    if (o >= s->rule_len) abort();
    uint32_t n = s->decl[i].next;
    uint32_t p = 0;
    for (uint32_t x = s->rule[o].first_decl; x && x != i; x = s->decl[x].next) p = x;
    if (p) s->decl[p].next = n; else s->rule[o].first_decl = n;
    if (s->rule[o].last_decl == i) s->rule[o].last_decl = p;
    s->decl[i].rule = 0;
    s->decl[i].next = 0;
}

uint32_t store_css_store_tag_decls_first(const store_css_store_tag *s, uint32_t o) { if (o >= s->rule_len) abort(); return s->rule[o].first_decl; }

uint32_t store_css_store_tag_decls_next(const store_css_store_tag *s, uint32_t i) { if (i >= s->decl_len) abort(); return s->decl[i].next; }

uint32_t store_css_store_tag_decls_up(const store_css_store_tag *s, uint32_t i) { if (i >= s->decl_len) abort(); return s->decl[i].rule; }

size_t store_css_store_tag_decls_count(const store_css_store_tag *s, uint32_t o) {
    size_t n = 0;
    if (o >= s->rule_len) abort();
    for (uint32_t i = s->rule[o].first_decl; i; i = s->decl[i].next) {
        n++;
        if (n > s->decl_len) abort();
    }
    return n;
}

