    return CSS_OK;
}

css_status css_check_set_state(const css_style *d, dom_document *doc, css_state_kind kind, uint32_t node)
{
    return CSS_OK;
}

css_rule_h css_rules_first(const css_style *d, css_sheet_h h) {
    css_rule_h none = { 0, 0, 0 };
    if (!sheet_live(d, h)) return none;
    return rule_handle(d, d->sheet[h.index].first_rule);
}
css_rule_h css_rules_next(const css_style *d, css_rule_h h) {
    css_rule_h none = { 0, 0, 0 };
    if (!rule_live(d, h)) return none;
    return rule_handle(d, d->rule[h.index].next);
}
css_sheet_h css_rules_up(const css_style *d, css_rule_h h) {
    css_sheet_h none = { 0, 0, 0 };
    if (!rule_live(d, h)) return none;
    return sheet_handle(d, d->rule[h.index].sheet);
}
css_rule_h css_rules_last(const css_style *d, css_sheet_h h) {
    css_rule_h none = { 0, 0, 0 };
    if (!sheet_live(d, h)) return none;
    return rule_handle(d, d->sheet[h.index].last_rule);
}
size_t css_rules_count(const css_style *d, css_sheet_h h) {
    if (!sheet_live(d, h)) return 0;
    return rules_count(d, h.index);
}

css_decl_h css_decls_first(const css_style *d, css_rule_h h) {
    css_decl_h none = { 0, 0, 0 };
    if (!rule_live(d, h)) return none;
    return decl_handle(d, d->rule[h.index].first_decl);
}
css_decl_h css_decls_next(const css_style *d, css_decl_h h) {
    css_decl_h none = { 0, 0, 0 };
    if (!decl_live(d, h)) return none;
    return decl_handle(d, d->decl[h.index].next);
}
css_rule_h css_decls_up(const css_style *d, css_decl_h h) {
    css_rule_h none = { 0, 0, 0 };
    if (!decl_live(d, h)) return none;
    return rule_handle(d, d->decl[h.index].rule);
}
css_decl_h css_decls_last(const css_style *d, css_rule_h h) {
    css_decl_h none = { 0, 0, 0 };
    if (!rule_live(d, h)) return none;
    return decl_handle(d, d->rule[h.index].last_decl);
}
size_t css_decls_count(const css_style *d, css_rule_h h) {
    if (!rule_live(d, h)) return 0;
    return decls_count(d, h.index);
}

int css_check_invariants(const css_style *d, FILE *report) {
    int bad = 0;
    /* rule_links */
    {
        own uint32_t *seen = (uint32_t *)calloc(d->rule_len ? d->rule_len : 1, sizeof(uint32_t));
        if (!seen) abort();
        for (uint32_t o = 1; o < d->sheet_len; o++) {
            if (!d->sheet[o].live) continue;
            uint32_t prev = 0;
            size_t steps = 0;
            for (uint32_t i = d->sheet[o].first_rule; i; i = d->rule[i].next) {
                if (i >= d->rule_len || !d->rule[i].live || d->rule[i].sheet != o || ++steps > d->rule_len || seen[i]) { bad++; amb_report(report, "css", "rule_links", o); break; }
                seen[i] = o;
                prev = i;
            }
        if (d->sheet[o].last_rule != prev) { bad++; amb_report(report, "css", "rule_links", o); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++)
            if (d->rule[i].live && d->rule[i].sheet && seen[i] != d->rule[i].sheet) { bad++; amb_report(report, "css", "rule_links", i); }
        free(seen);
    }
    /* decl_links */
    {
        own uint32_t *seen = (uint32_t *)calloc(d->decl_len ? d->decl_len : 1, sizeof(uint32_t));
        if (!seen) abort();
        for (uint32_t o = 1; o < d->rule_len; o++) {
            if (!d->rule[o].live) continue;
            uint32_t prev = 0;
            size_t steps = 0;
            for (uint32_t i = d->rule[o].first_decl; i; i = d->decl[i].next) {
                if (i >= d->decl_len || !d->decl[i].live || d->decl[i].rule != o || ++steps > d->decl_len || seen[i]) { bad++; amb_report(report, "css", "decl_links", o); break; }
                seen[i] = o;
                prev = i;
            }
        if (d->rule[o].last_decl != prev) { bad++; amb_report(report, "css", "decl_links", o); }
        }
        for (uint32_t i = 1; i < d->decl_len; i++)
            if (d->decl[i].live && d->decl[i].rule && seen[i] != d->decl[i].rule) { bad++; amb_report(report, "css", "decl_links", i); }
        free(seen);
    }
    /* live_links */
    {
        for (uint32_t i = 1; i < d->sheet_len; i++) {
            uint32_t r = d->sheet[i].first_rule;
            if (d->sheet[i].live && r && (r >= d->rule_len || !d->rule[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->sheet_len; i++) {
            uint32_t r = d->sheet[i].last_rule;
            if (d->sheet[i].live && r && (r >= d->rule_len || !d->rule[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->sheet_len; i++) {
            uint32_t r = d->sheet[i].parent;
            if (d->sheet[i].live && r && (r >= d->sheet_len || !d->sheet[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++) {
            uint32_t r = d->rule[i].sheet;
            if (d->rule[i].live && r && (r >= d->sheet_len || !d->sheet[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++) {
            uint32_t r = d->rule[i].next;
            if (d->rule[i].live && r && (r >= d->rule_len || !d->rule[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++) {
            uint32_t r = d->rule[i].first_decl;
            if (d->rule[i].live && r && (r >= d->decl_len || !d->decl[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++) {
            uint32_t r = d->rule[i].last_decl;
            if (d->rule[i].live && r && (r >= d->decl_len || !d->decl[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++) {
            uint32_t r = d->rule[i].layer;
            if (d->rule[i].live && r && (r >= d->layer_len || !d->layer[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->rule_len; i++) {
            uint32_t r = d->rule[i].keyframes;
            if (d->rule[i].live && r && (r >= d->keyframes_len || !d->keyframes[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->decl_len; i++) {
            uint32_t r = d->decl[i].rule;
            if (d->decl[i].live && r && (r >= d->rule_len || !d->rule[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->decl_len; i++) {
            uint32_t r = d->decl[i].next;
            if (d->decl[i].live && r && (r >= d->decl_len || !d->decl[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->match_len; i++) {
            uint32_t r = d->match[i].rule;
            if (d->match[i].live && r && (r >= d->rule_len || !d->rule[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->cval_len; i++) {
            uint32_t r = d->cval[i].winner;
            if (d->cval[i].live && r && (r >= d->decl_len || !d->decl[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->estyle_len; i++) {
            uint32_t r = d->estyle[i].first;
            if (d->estyle[i].live && r && (r >= d->cval_len || !d->cval[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->layer_len; i++) {
            uint32_t r = d->layer[i].parent;
            if (d->layer[i].live && r && (r >= d->layer_len || !d->layer[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->pstyle_len; i++) {
            uint32_t r = d->pstyle[i].first;
            if (d->pstyle[i].live && r && (r >= d->cval_len || !d->cval[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->keyframes_len; i++) {
            uint32_t r = d->keyframes[i].sheet;
            if (d->keyframes[i].live && r && (r >= d->sheet_len || !d->sheet[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->keyframes_len; i++) {
            uint32_t r = d->keyframes[i].layer;
            if (d->keyframes[i].live && r && (r >= d->layer_len || !d->layer[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->regprop_len; i++) {
            uint32_t r = d->regprop[i].sheet;
            if (d->regprop[i].live && r && (r >= d->sheet_len || !d->sheet[r].live)) { bad++; amb_report(report, "css", "live_links", i); }
        }
    }
    return bad;
}
void css_export(const css_style *d, FILE *out) {
    fprintf(out, "amb_snapshot(css, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, css_fingerprint);
    for (uint32_t i = 1; i < d->sheet_len; i++) {
        if (!d->sheet[i].live) continue;
        if (1) { fputs("css_sheet(", out); amb_put_handle(out, "sh", d->id, i, d->sheet[i].gen); fputs(",", out); fputs(css_origin_name(d->sheet[i].origin), out); fputs(").\n", out); }
        if (d->sheet[i].parent != 0) { fputs("css_imported(", out); amb_put_handle(out, "sh", d->id, i, d->sheet[i].gen); fputs(",", out); { uint32_t r = d->sheet[i].parent; amb_put_ref(out, "sh", d->id, r, r && r < d->sheet_len ? d->sheet[r].gen : 0); } fputs(",", out); text_put(d, out, d->sheet[i].url); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->rule_len; i++) {
        if (!d->rule[i].live) continue;
        if (1) { fputs("css_rule(", out); amb_put_handle(out, "ru", d->id, i, d->rule[i].gen); fputs(",", out); { uint32_t r = d->rule[i].sheet; amb_put_ref(out, "sh", d->id, r, r && r < d->sheet_len ? d->sheet[r].gen : 0); } fputs(",", out); text_put(d, out, d->rule[i].selector); fputs(",", out); fprintf(out, "%lld", (long long)d->rule[i].spec); fputs(",", out); fprintf(out, "%lld", (long long)d->rule[i].order); fputs(").\n", out); }
        if (d->rule[i].layer != 0) { fputs("css_rule_layer(", out); amb_put_handle(out, "ru", d->id, i, d->rule[i].gen); fputs(",", out); { uint32_t r = d->rule[i].layer; amb_put_ref(out, "ly", d->id, r, r && r < d->layer_len ? d->layer[r].gen : 0); } fputs(").\n", out); }
        if (d->rule[i].keyframes != 0) { fputs("css_keyframe(", out); amb_put_handle(out, "ru", d->id, i, d->rule[i].gen); fputs(",", out); { uint32_t r = d->rule[i].keyframes; amb_put_ref(out, "kf", d->id, r, r && r < d->keyframes_len ? d->keyframes[r].gen : 0); } fputs(",", out); amb_put_f64(out, d->rule[i].offset); fputs(").\n", out); }
        if (d->rule[i].scoped == 1) { fputs("css_scope(", out); amb_put_handle(out, "ru", d->id, i, d->rule[i].gen); fputs(",", out); text_put(d, out, d->rule[i].scope); fputs(",", out); text_put(d, out, d->rule[i].scope_end); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->decl_len; i++) {
        if (!d->decl[i].live) continue;
        if (1) { fputs("css_decl(", out); amb_put_handle(out, "de", d->id, i, d->decl[i].gen); fputs(",", out); { uint32_t r = d->decl[i].rule; amb_put_ref(out, "ru", d->id, r, r && r < d->rule_len ? d->rule[r].gen : 0); } fputs(",", out); fputs(css_prop_name(d->decl[i].prop), out); fputs(",", out); text_put(d, out, d->decl[i].text); fputs(",", out); fputs(d->decl[i].important ? "true" : "false", out); fputs(").\n", out); }
        if (d->decl[i].prop == CSS_PROP_CUSTOM) { fputs("css_decl_custom(", out); amb_put_handle(out, "de", d->id, i, d->decl[i].gen); fputs(",", out); names_put(d, out, d->decl[i].word); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->match_len; i++) {
        if (!d->match[i].live) continue;
        if (d->match[i].pseudo == CSS_PSEUDO_ELEMENT) { fputs("css_matched(", out); amb_put_ref(out, "n", d->match[i].node.doc, d->match[i].node.index, d->match[i].node.gen); fputs(",", out); { uint32_t r = d->match[i].rule; amb_put_ref(out, "ru", d->id, r, r && r < d->rule_len ? d->rule[r].gen : 0); } fputs(").\n", out); }
        if (d->match[i].proximity != 0) { fputs("css_match_proximity(", out); amb_put_ref(out, "n", d->match[i].node.doc, d->match[i].node.index, d->match[i].node.gen); fputs(",", out); { uint32_t r = d->match[i].rule; amb_put_ref(out, "ru", d->id, r, r && r < d->rule_len ? d->rule[r].gen : 0); } fputs(",", out); fprintf(out, "%lld", (long long)d->match[i].proximity); fputs(").\n", out); }
        if (d->match[i].pseudo != CSS_PSEUDO_ELEMENT) { fputs("css_pseudo_matched(", out); amb_put_ref(out, "n", d->match[i].node.doc, d->match[i].node.index, d->match[i].node.gen); fputs(",", out); fputs(css_pseudo_name(d->match[i].pseudo), out); fputs(",", out); { uint32_t r = d->match[i].rule; amb_put_ref(out, "ru", d->id, r, r && r < d->rule_len ? d->rule[r].gen : 0); } fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->cval_len; i++) {
        if (!d->cval[i].live) continue;
        if ((d->cval[i].winner != 0) && (d->cval[i].prop != CSS_PROP_CUSTOM)) { fputs("css_style_declared(", out); fprintf(out, "%lld", (long long)d->cval[i].style); fputs(",", out); fputs(css_prop_name(d->cval[i].prop), out); fputs(",", out); text_put(d, out, d->cval[i].text); fputs(",", out); fputs(css_how_name(d->cval[i].how), out); fputs(").\n", out); }
        if ((d->cval[i].winner != 0) && (d->cval[i].prop != CSS_PROP_CUSTOM)) { fputs("css_style_won(", out); fprintf(out, "%lld", (long long)d->cval[i].style); fputs(",", out); fputs(css_prop_name(d->cval[i].prop), out); fputs(",", out); { uint32_t r = d->cval[i].winner; amb_put_ref(out, "de", d->id, r, r && r < d->decl_len ? d->decl[r].gen : 0); } fputs(").\n", out); }
        if ((d->cval[i].prop == CSS_PROP_CUSTOM) && (d->cval[i].winner != 0)) { fputs("css_style_custom(", out); fprintf(out, "%lld", (long long)d->cval[i].style); fputs(",", out); names_put(d, out, d->cval[i].word); fputs(",", out); text_put(d, out, d->cval[i].text); fputs(",", out); fputs(css_how_name(d->cval[i].how), out); fputs(",", out); { uint32_t r = d->cval[i].winner; amb_put_ref(out, "de", d->id, r, r && r < d->decl_len ? d->decl[r].gen : 0); } fputs(").\n", out); }
        if ((d->cval[i].unit == CSS_UNIT_COLOR) && (d->cval[i].winner != 0)) { fputs("css_style_rgba(", out); fprintf(out, "%lld", (long long)d->cval[i].style); fputs(",", out); fputs(css_prop_name(d->cval[i].prop), out); fputs(",", out); fprintf(out, "%lld", (long long)d->cval[i].color); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->estyle_len; i++) {
        if (!d->estyle[i].live) continue;
        if (1) { fputs("css_style_of(", out); amb_put_ref(out, "n", d->estyle[i].node.doc, d->estyle[i].node.index, d->estyle[i].node.gen); fputs(",", out); fprintf(out, "%lld", (long long)d->estyle[i].style); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->initval_len; i++) {
        if (!d->initval[i].live) continue;
        if (1) { fputs("css_initial(", out); fputs(css_prop_name(d->initval[i].prop), out); fputs(",", out); text_put(d, out, d->initval[i].text); fputs(").\n", out); }
        if (d->initval[i].unit == CSS_UNIT_COLOR) { fputs("css_initial_rgba(", out); fputs(css_prop_name(d->initval[i].prop), out); fputs(",", out); fprintf(out, "%lld", (long long)d->initval[i].color); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->layer_len; i++) {
        if (!d->layer[i].live) continue;
        if (1) { fputs("css_layer(", out); amb_put_handle(out, "ly", d->id, i, d->layer[i].gen); fputs(",", out); text_put(d, out, d->layer[i].name); fputs(",", out); fprintf(out, "%lld", (long long)d->layer[i].rank); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->face_len; i++) {
        if (!d->face[i].live) continue;
        if (1) { fputs("css_font_face(", out); amb_put_handle(out, "ff", d->id, i, d->face[i].gen); fputs(",", out); text_put(d, out, d->face[i].family); fputs(",", out); text_put(d, out, d->face[i].url); fputs(",", out); fprintf(out, "%lld", (long long)d->face[i].weight); fputs(",", out); fputs(d->face[i].italic ? "true" : "false", out); fputs(").\n", out); }
        if (1) { fputs("css_font_face_font(", out); amb_put_handle(out, "ff", d->id, i, d->face[i].gen); fputs(",", out); amb_put_ref(out, "rs", d->face[i].font.doc, d->face[i].font.index, d->face[i].font.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->pstyle_len; i++) {
        if (!d->pstyle[i].live) continue;
        if (1) { fputs("css_pseudo_style_of(", out); amb_put_ref(out, "n", d->pstyle[i].node.doc, d->pstyle[i].node.index, d->pstyle[i].node.gen); fputs(",", out); fputs(css_pseudo_name(d->pstyle[i].pseudo), out); fputs(",", out); fprintf(out, "%lld", (long long)d->pstyle[i].style); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->state_len; i++) {
        if (!d->state[i].live) continue;
        if (1) { fputs("css_state(", out); fputs(css_state_kind_name(d->state[i].kind), out); fputs(",", out); amb_put_ref(out, "n", d->state[i].node.doc, d->state[i].node.index, d->state[i].node.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->keyframes_len; i++) {
        if (!d->keyframes[i].live) continue;
        if (1) { fputs("css_keyframes(", out); amb_put_handle(out, "kf", d->id, i, d->keyframes[i].gen); fputs(",", out); text_put(d, out, d->keyframes[i].name); fputs(",", out); { uint32_t r = d->keyframes[i].sheet; amb_put_ref(out, "sh", d->id, r, r && r < d->sheet_len ? d->sheet[r].gen : 0); } fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->regprop_len; i++) {
        if (!d->regprop[i].live) continue;
        if (1) { fputs("css_registered(", out); amb_put_handle(out, "rg", d->id, i, d->regprop[i].gen); fputs(",", out); names_put(d, out, d->regprop[i].name); fputs(",", out); text_put(d, out, d->regprop[i].syntax); fputs(",", out); fputs(d->regprop[i].inherits ? "true" : "false", out); fputs(",", out); text_put(d, out, d->regprop[i].initial); fputs(").\n", out); }
    }
}
css_status css_dispatch(css_style *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    css_status st = CSS_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return CSS_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return CSS_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return CSS_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return CSS_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return CSS_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return CSS_STALE_REVISION; }

    if (amb_name_is(name, name_len, "parse_sheet") || amb_name_is(name, name_len, "cascade") || amb_name_is(name, name_len, "set_state")) { amb_result(report, name, "not_requestable", d->revision); return CSS_NOT_REQUESTABLE; }
