const char a11y_fingerprint[] = "fnv1a32:8a1e7357:8766";
void a11y_init(a11y_tree *d, uint32_t id) {
    if (d->anode_len != 0) abort();
    d->id = id;
    d->revision = 0;
    text_add(d, "", 0);
}
uint64_t a11y_revision(const a11y_tree *d) { return d->revision; }
a11y_status a11y_check_build(const a11y_tree *d, dom_document *doc, css_style *style)
{
    return A11Y_OK;
}

a11y_status a11y_check_print_tree(const a11y_tree *d, dom_document *doc, FILE *out)
{
    return A11Y_OK;
}

int a11y_check_invariants(const a11y_tree *d, FILE *report) {
    int bad = 0;
    /* live_links */
    {
        for (uint32_t i = 1; i < d->anode_len; i++) {
            uint32_t r = d->anode[i].parent;
            if (d->anode[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->anode_len; i++) {
            uint32_t r = d->anode[i].region;
            if (d->anode[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->atext_len; i++) {
            uint32_t r = d->atext[i].node;
            if (d->atext[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->arange_len; i++) {
            uint32_t r = d->arange[i].node;
            if (d->arange[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->alive_len; i++) {
            uint32_t r = d->alive[i].node;
            if (d->alive[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->astate_len; i++) {
            uint32_t r = d->astate[i].node;
            if (d->astate[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->avalid_len; i++) {
            uint32_t r = d->avalid[i].node;
            if (d->avalid[i].live && r && (r >= d->anode_len || !d->anode[r].live)) { bad++; amb_report(report, "a11y", "live_links", i); }
        }
    }
    return bad;
}
void a11y_export(const a11y_tree *d, FILE *out) {
    fprintf(out, "amb_snapshot(a11y, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, a11y_fingerprint);
    for (uint32_t i = 1; i < d->anode_len; i++) {
        if (!d->anode[i].live) continue;
        if (1) { fputs("a11y_node(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); amb_put_ref(out, "n", d->anode[i].node.doc, d->anode[i].node.index, d->anode[i].node.gen); fputs(",", out); fputs(a11y_role_name(d->anode[i].role), out); fputs(",", out); text_put(d, out, d->anode[i].name); fputs(",", out); fputs(a11y_name_from_name(d->anode[i].name_from), out); fputs(").\n", out); }
        if (d->anode[i].parent != 0) { fputs("a11y_parent(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); { uint32_t r = d->anode[i].parent; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(").\n", out); }
        if (d->anode[i].stated == 1) { fputs("a11y_explicit_role(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(").\n", out); }
        if (d->anode[i].role == A11Y_ROLE_HEADING) { fputs("a11y_heading(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->anode[i].level); fputs(").\n", out); }
        if (d->anode[i].focusable == 1) { fputs("a11y_focusable(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(").\n", out); }
        if (d->anode[i].level != 0) { fputs("a11y_level(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->anode[i].level); fputs(").\n", out); }
        if (d->anode[i].posinset != 0) { fputs("a11y_position(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->anode[i].posinset); fputs(",", out); fprintf(out, "%lld", (long long)d->anode[i].setsize); fputs(").\n", out); }
        if (d->anode[i].region != 0) { fputs("a11y_live_region(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); { uint32_t r = d->anode[i].region; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->atext_len; i++) {
        if (!d->atext[i].live) continue;
        if (d->atext[i].prop == A11Y_TEXT_PROP_DESCRIPTION) { fputs("a11y_description(", out); { uint32_t r = d->atext[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); text_put(d, out, d->atext[i].text); fputs(",", out); fputs(a11y_desc_from_name(d->atext[i].desc_from), out); fputs(").\n", out); }
        if (d->atext[i].prop == A11Y_TEXT_PROP_VALUE) { fputs("a11y_value(", out); { uint32_t r = d->atext[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); text_put(d, out, d->atext[i].text); fputs(").\n", out); }
        if (d->atext[i].prop == A11Y_TEXT_PROP_PLACEHOLDER) { fputs("a11y_placeholder(", out); { uint32_t r = d->atext[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); text_put(d, out, d->atext[i].text); fputs(").\n", out); }
        if (d->atext[i].prop == A11Y_TEXT_PROP_VALUETEXT) { fputs("a11y_valuetext(", out); { uint32_t r = d->atext[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); text_put(d, out, d->atext[i].text); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->arange_len; i++) {
        if (!d->arange[i].live) continue;
        if (d->arange[i].has_now == 1) { fputs("a11y_valuenow(", out); { uint32_t r = d->arange[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); amb_put_f64(out, d->arange[i].valuenow); fputs(",", out); fputs(a11y_value_from_name(d->arange[i].now_from), out); fputs(").\n", out); }
        if (d->arange[i].has_min == 1) { fputs("a11y_valuemin(", out); { uint32_t r = d->arange[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); amb_put_f64(out, d->arange[i].valuemin); fputs(").\n", out); }
        if (d->arange[i].has_max == 1) { fputs("a11y_valuemax(", out); { uint32_t r = d->arange[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); amb_put_f64(out, d->arange[i].valuemax); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->alive_len; i++) {
        if (!d->alive[i].live) continue;
        if (1) { fputs("a11y_live(", out); { uint32_t r = d->alive[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); fputs(a11y_politeness_name(d->alive[i].politeness), out); fputs(",", out); fputs(d->alive[i].atomic ? "true" : "false", out); fputs(",", out); text_put(d, out, d->alive[i].relevant); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->astate_len; i++) {
        if (!d->astate[i].live) continue;
        if (1) { fputs("a11y_state(", out); { uint32_t r = d->astate[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); fputs(a11y_state_name(d->astate[i].state), out); fputs(",", out); fputs(a11y_token_name(d->astate[i].value), out); fputs(").\n", out); }
        if (1) { fputs("a11y_state_from(", out); { uint32_t r = d->astate[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); fputs(a11y_state_name(d->astate[i].state), out); fputs(",", out); fputs(a11y_state_from_name(d->astate[i].from), out); fputs(",", out); amb_put_ref(out, "n", d->astate[i].by.doc, d->astate[i].by.index, d->astate[i].by.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->aref_len; i++) {
        if (!d->aref[i].live) continue;
        if (1) { fputs("a11y_ref(", out); amb_put_ref(out, "n", d->aref[i].from.doc, d->aref[i].from.index, d->aref[i].from.gen); fputs(",", out); fputs(a11y_ref_attr_name(d->aref[i].attr), out); fputs(",", out); text_put(d, out, d->aref[i].idref); fputs(",", out); amb_put_ref(out, "n", d->aref[i].target.doc, d->aref[i].target.index, d->aref[i].target.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->badrole_len; i++) {
        if (!d->badrole[i].live) continue;
        if (1) { fputs("a11y_bad_role(", out); amb_put_ref(out, "n", d->badrole[i].node.doc, d->badrole[i].node.index, d->badrole[i].node.gen); fputs(",", out); text_put(d, out, d->badrole[i].value); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->ahidden_len; i++) {
        if (!d->ahidden[i].live) continue;
        if (1) { fputs("a11y_hidden(", out); amb_put_ref(out, "n", d->ahidden[i].node.doc, d->ahidden[i].node.index, d->ahidden[i].node.gen); fputs(",", out); fputs(a11y_hidden_how_name(d->ahidden[i].how), out); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->ahinside_len; i++) {
        if (!d->ahinside[i].live) continue;
        if (d->ahinside[i].what == A11Y_INSIDE_WHAT_FOCUSABLE) { fputs("a11y_hidden_focusable(", out); amb_put_ref(out, "n", d->ahinside[i].node.doc, d->ahinside[i].node.index, d->ahinside[i].node.gen); fputs(",", out); amb_put_ref(out, "n", d->ahinside[i].root.doc, d->ahinside[i].root.index, d->ahinside[i].root.gen); fputs(").\n", out); }
        if (d->ahinside[i].what == A11Y_INSIDE_WHAT_LIVE_REGION) { fputs("a11y_hidden_live(", out); amb_put_ref(out, "n", d->ahinside[i].node.doc, d->ahinside[i].node.index, d->ahinside[i].node.gen); fputs(",", out); amb_put_ref(out, "n", d->ahinside[i].root.doc, d->ahinside[i].root.index, d->ahinside[i].root.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->aplain_len; i++) {
        if (!d->aplain[i].live) continue;
        if (1) { fputs("a11y_no_node(", out); amb_put_ref(out, "n", d->aplain[i].node.doc, d->aplain[i].node.index, d->aplain[i].node.gen); fputs(",", out); fputs(a11y_role_name(d->aplain[i].role), out); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->avalid_len; i++) {
        if (!d->avalid[i].live) continue;
        if (1) { fputs("a11y_validity(", out); { uint32_t r = d->avalid[i].node; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(",", out); fputs(a11y_validity_name(d->avalid[i].flag), out); fputs(").\n", out); }
    }
}
a11y_status a11y_dispatch(a11y_tree *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    a11y_status st = A11Y_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return A11Y_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return A11Y_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return A11Y_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return A11Y_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return A11Y_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return A11Y_STALE_REVISION; }

    if (amb_name_is(name, name_len, "build") || amb_name_is(name, name_len, "print_tree")) { amb_result(report, name, "not_requestable", d->revision); return A11Y_NOT_REQUESTABLE; }
    amb_result(report, name, "bad_request", d->revision);
    return st;
}
/* the store of module a11y, an instance of store<a11y_store_tag>: one own buffer a part */
typedef struct store_a11y_store_tag {
    uint32_t id;
    uint64_t revision;
    size_t anode_len, anode_cap;
    uint32_t anode_free;
    own a11y_anode *anode;
    size_t atext_len, atext_cap;
    uint32_t atext_free;
    own a11y_atext *atext;
    size_t arange_len, arange_cap;
    uint32_t arange_free;
    own a11y_arange *arange;
    size_t alive_len, alive_cap;
    uint32_t alive_free;
    own a11y_alive *alive;
    size_t astate_len, astate_cap;
    uint32_t astate_free;
    own a11y_astate *astate;
    size_t aref_len, aref_cap;
    uint32_t aref_free;
    own a11y_aref *aref;
    size_t badrole_len, badrole_cap;
    uint32_t badrole_free;
    own a11y_badrole *badrole;
    size_t ahidden_len, ahidden_cap;
    uint32_t ahidden_free;
    own a11y_ahidden *ahidden;
    size_t ahinside_len, ahinside_cap;
    uint32_t ahinside_free;
    own a11y_ahinside *ahinside;
    size_t aplain_len, aplain_cap;
    uint32_t aplain_free;
    own a11y_aplain *aplain;
    size_t avalid_len, avalid_cap;
    uint32_t avalid_free;
    own a11y_avalid *avalid;
    size_t text_len, text_cap;
    own char *text;
} store_a11y_store_tag;
void store_a11y_store_tag_drop(store_a11y_store_tag *s) { free(s->anode); free(s->atext); free(s->arange); free(s->alive); free(s->astate); free(s->aref); free(s->badrole); free(s->ahidden); free(s->ahinside); free(s->aplain); free(s->avalid); free(s->text); }
static void store_a11y_store_tag__anode_grow(store_a11y_store_tag *s) {
    size_t c = s->anode_cap ? 2 * s->anode_cap : 16;
    if (c > 0x7FFFFFFF) abort();
    s->anode = (a11y_anode *)realloc(s->anode, c * sizeof(a11y_anode));
    if (!s->anode) abort();
    s->anode_cap = c;
}
a11y_anode_h store_a11y_store_tag_anode_new(store_a11y_store_tag *s) {
    uint32_t i;
    if (s->anode_free) {
        i = s->anode_free;
        s->anode_free = s->anode[i].free_next;
    } else {
        if (s->anode_len == 0) {
            if (s->anode_cap == 0) store_a11y_store_tag__anode_grow(s);
            memset(&s->anode[0], 0, sizeof(a11y_anode));
            s->anode_len = 1;
        }
        if (s->anode_len == s->anode_cap) store_a11y_store_tag__anode_grow(s);
        i = (uint32_t)s->anode_len;
        s->anode_len++;
        s->anode[i].gen = 0;
    }
    uint32_t g = s->anode[i].gen;
    memset(&s->anode[i], 0, sizeof(a11y_anode));
    s->anode[i].gen = g;
    s->anode[i].live = 1;
    a11y_anode_h h = { s->id, i, g };
    return h;
}
int store_a11y_store_tag_anode_live(const store_a11y_store_tag *s, a11y_anode_h h) {
    return h.doc == s->id && h.index != 0 && h.index < s->anode_len && s->anode[h.index].live && s->anode[h.index].gen == h.gen;
}
a11y_anode store_a11y_store_tag_anode_get(const store_a11y_store_tag *s, a11y_anode_h h) {
    if (!store_a11y_store_tag_anode_live(s, h)) abort();
    return s->anode[h.index];
}
a11y_anode *store_a11y_store_tag_anode_ref(const store_a11y_store_tag *s, a11y_anode_h h) tie s {
    if (!store_a11y_store_tag_anode_live(s, h)) abort();
    return &s->anode[h.index];
}
a11y_anode *store_a11y_store_tag_anode_slot(const store_a11y_store_tag *s, uint32_t i) tie s {
    if (i == 0 || i >= s->anode_len) abort();
