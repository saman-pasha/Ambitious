            s->badrole_len = 1;
        }
        if (s->badrole_len == s->badrole_cap) store_a11y_store_tag__badrole_grow(s);
        i = (uint32_t)s->badrole_len;
        s->badrole_len++;
        s->badrole[i].gen = 0;
    }
    uint32_t g = s->badrole[i].gen;
    memset(&s->badrole[i], 0, sizeof(a11y_badrole));
    s->badrole[i].gen = g;
    s->badrole[i].live = 1;
    a11y_badrole_h h = { s->id, i, g };
    return h;
}
int store_a11y_store_tag_badrole_live(const store_a11y_store_tag *s, a11y_badrole_h h) {
    return h.doc == s->id && h.index != 0 && h.index < s->badrole_len && s->badrole[h.index].live && s->badrole[h.index].gen == h.gen;
}
a11y_badrole store_a11y_store_tag_badrole_get(const store_a11y_store_tag *s, a11y_badrole_h h) {
    if (!store_a11y_store_tag_badrole_live(s, h)) abort();
    return s->badrole[h.index];
}
a11y_badrole *store_a11y_store_tag_badrole_ref(const store_a11y_store_tag *s, a11y_badrole_h h) tie s {
    if (!store_a11y_store_tag_badrole_live(s, h)) abort();
    return &s->badrole[h.index];
}
a11y_badrole *store_a11y_store_tag_badrole_slot(const store_a11y_store_tag *s, uint32_t i) tie s {
    if (i == 0 || i >= s->badrole_len) abort();
    return &s->badrole[i];
}
a11y_badrole_h store_a11y_store_tag_badrole_handle(const store_a11y_store_tag *s, uint32_t i) {
    a11y_badrole_h h = { 0, 0, 0 };
    if (i != 0 && i < s->badrole_len && s->badrole[i].live) {
        h.doc = s->id;
        h.index = i;
        h.gen = s->badrole[i].gen;
    }
    return h;
}
void store_a11y_store_tag_badrole_free(store_a11y_store_tag *s, a11y_badrole_h h) {
    if (!store_a11y_store_tag_badrole_live(s, h)) abort();
    s->badrole[h.index].live = 0;
    s->badrole[h.index].gen++;
    s->badrole[h.index].free_next = s->badrole_free;
    s->badrole_free = h.index;
}
size_t store_a11y_store_tag_badrole_len(const store_a11y_store_tag *s) { return s->badrole_len; }
size_t store_a11y_store_tag_badrole_count(const store_a11y_store_tag *s) {
    size_t n = 0;
    for (size_t i = 1; i < s->badrole_len; i++) if (s->badrole[i].live) n++;
    return n;
}
static void store_a11y_store_tag__text_room(store_a11y_store_tag *s, size_t n) {
    if (s->text_len + n <= s->text_cap) return;
    size_t c = s->text_cap ? s->text_cap : 256;
    while (c < s->text_len + n) c *= 2;
    if (c > 0x7FFFFFFF) abort();
    s->text = (char *)realloc(s->text, c);
    if (!s->text) abort();
    s->text_cap = c;
}
amb_span store_a11y_store_tag_text_add(store_a11y_store_tag *s, const char *p, size_t n) {
    amb_span sp = { 0, 0 };
    if (s->text_len == 0) {
        store_a11y_store_tag__text_room(s, 1);
        s->text[0] = 0;
        s->text_len = 1;
    }
    if (n == 0) return sp;
    int inside = p >= s->text && p < s->text + s->text_len;
    size_t from = inside ? (size_t)(p - s->text) : 0;
    store_a11y_store_tag__text_room(s, n);
    if (inside) memmove(s->text + s->text_len, s->text + from, n);
    else memcpy(s->text + s->text_len, p, n);
    sp.off = (uint32_t)s->text_len;
    sp.len = (uint32_t)n;
    s->text_len += n;
    return sp;
}
const char *store_a11y_store_tag_text_ptr(const store_a11y_store_tag *s, amb_span sp) tie s {
    if (s->text_len == 0 || (size_t)sp.off + sp.len > s->text_len) abort();
    return s->text + sp.off;
}
int store_a11y_store_tag_text_eq(const store_a11y_store_tag *s, amb_span sp, const char *p, size_t n) {
    if (sp.len != n) return 0;
    if (n == 0) return 1;
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    return memcmp(s->text + sp.off, p, n) == 0;
}
void store_a11y_store_tag_text_put(const store_a11y_store_tag *s, FILE *out, amb_span sp) {
    if (sp.len == 0) { amb_put_qatom(out, "", 0); return; }
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    amb_put_qatom(out, s->text + sp.off, sp.len);
}
size_t store_a11y_store_tag_text_size(const store_a11y_store_tag *s) { return s->text_len; }
