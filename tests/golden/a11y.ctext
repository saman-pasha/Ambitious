        if (d->anode[i].parent != 0) { fputs("a11y_parent(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); { uint32_t r = d->anode[i].parent; amb_put_ref(out, "ax", d->id, r, r && r < d->anode_len ? d->anode[r].gen : 0); } fputs(").\n", out); }
        if (d->anode[i].stated == 1) { fputs("a11y_explicit_role(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(").\n", out); }
        if (d->anode[i].role == A11Y_ROLE_HEADING) { fputs("a11y_heading(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->anode[i].level); fputs(").\n", out); }
        if (d->anode[i].focusable == 1) { fputs("a11y_focusable(", out); amb_put_handle(out, "ax", d->id, i, d->anode[i].gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->aref_len; i++) {
        if (!d->aref[i].live) continue;
        if (1) { fputs("a11y_ref(", out); amb_put_ref(out, "n", d->aref[i].from.doc, d->aref[i].from.index, d->aref[i].from.gen); fputs(",", out); fputs(a11y_ref_attr_name(d->aref[i].attr), out); fputs(",", out); text_put(d, out, d->aref[i].idref); fputs(",", out); amb_put_ref(out, "n", d->aref[i].target.doc, d->aref[i].target.index, d->aref[i].target.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->badrole_len; i++) {
        if (!d->badrole[i].live) continue;
        if (1) { fputs("a11y_bad_role(", out); amb_put_ref(out, "n", d->badrole[i].node.doc, d->badrole[i].node.index, d->badrole[i].node.gen); fputs(",", out); text_put(d, out, d->badrole[i].value); fputs(").\n", out); }
    }
}
a11y_status a11y_dispatch(a11y_tree *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    a11y_status st = A11Y_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return A11Y_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return A11Y_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return A11Y_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return A11Y_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return A11Y_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return A11Y_STALE_REVISION; }

    if (amb_name_is(name, name_len, "build")) { amb_result(report, name, "not_requestable", d->revision); return A11Y_NOT_REQUESTABLE; }
    amb_result(report, name, "bad_request", d->revision);
    return st;
}
