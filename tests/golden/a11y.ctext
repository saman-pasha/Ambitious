        }
    }
    return bad;
}
void a11y_export(const a11y_tree *d, FILE *out) {
    fprintf(out, "amb_snapshot(a11y, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, a11y_fingerprint);
