%% build/schema/a11y.pl -- the reasoning schema of a11y, generated by tools/amb from contracts/a11y.pl.
%% Do not edit: change the contract and run `make schema`.
a11y_schema(module(a11y,'0.1.0','fnv1a32:655a7118:2900')).
a11y_schema(summary('Accessibility: the accessibility tree of a styled document, its roles and names and where each name came from')).
a11y_schema(handle(anode,ax)).
a11y_schema(handle(aref,ar)).
a11y_schema(handle(badrole,br)).
a11y_schema(enum(role,[document,generic,presentation,link,button,checkbox,radio,textbox,combobox,listbox,option,slider,img,heading,paragraph,list,listitem,table,row,cell,columnheader,rowheader,navigation,main,banner,contentinfo,complementary,region,form,search,article,dialog,figure,group,separator,term,definition,blockquote,code,progressbar,menu,menuitem,tab,tablist,tabpanel,alert,status,unknown])).
a11y_schema(enum(name_from,[nothing,aria_labelledby,aria_label,alt,label,caption,legend,content,title,placeholder,value])).
a11y_schema(enum(ref_attr,[aria_labelledby,aria_describedby,aria_controls,label_for])).
a11y_schema(status([ok,stale_handle,wrong_kind])).
a11y_schema(fact(a11y_node/5,[handle(anode),xhandle(dom,node),enum(role),atom,enum(name_from)])).
a11y_schema(fact(a11y_parent/2,[handle(anode),handle_or_none(anode)])).
a11y_schema(fact(a11y_explicit_role/1,[handle(anode)])).
a11y_schema(fact(a11y_heading/2,[handle(anode),integer])).
a11y_schema(fact(a11y_focusable/1,[handle(anode)])).
a11y_schema(fact(a11y_ref/4,[xhandle(dom,node),enum(ref_attr),atom,xhandle(dom,node)])).
a11y_schema(fact(a11y_bad_role/2,[xhandle(dom,node),atom])).
a11y_schema(derived(a11y_of/2,'the accessibility node of an element')).
a11y_schema(derived(a11y_missing_name/2,'a node whose role needs a name, without one')).
a11y_schema(derived(a11y_broken_ref/3,'an ID reference to no element')).
a11y_schema(derived(a11y_heading_jump/3,'a heading more than one level below the heading before it')).
a11y_schema(derived(a11y_nested_interactive/2,'an interactive node inside another')).
a11y_schema(derived(a11y_duplicate_id/3,'two elements with one id, which every reference to it confuses')).
a11y_schema(derived(a11y_explain_name/2,'why a node has its accessible name')).
a11y_schema(derived(a11y_outline/2,'the headings in document order, with their levels')).
a11y_schema(rules('rules/a11y')).
a11y_schema(operation(build,[store(dom),store(css)],status,[mutates])).
a11y_schema(query(tree,a11y_node(A,B,C,D,E),[A,C,D,E],'every node of the accessibility tree, its role and name')).
