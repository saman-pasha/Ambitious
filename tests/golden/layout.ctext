    for (size_t i = 1; i < s->frag_len; i++) if (s->frag[i].live) n++;
    return n;
}
static void store_layout_store_tag__text_room(store_layout_store_tag *s, size_t n) {
    if (s->text_len + n <= s->text_cap) return;
    size_t c = s->text_cap ? s->text_cap : 256;
    while (c < s->text_len + n) c *= 2;
    if (c > 0x7FFFFFFF) abort();
    s->text = (char *)realloc(s->text, c);
    if (!s->text) abort();
    s->text_cap = c;
}
amb_span store_layout_store_tag_text_add(store_layout_store_tag *s, const char *p, size_t n) {
    amb_span sp = { 0, 0 };
    if (s->text_len == 0) {
        store_layout_store_tag__text_room(s, 1);
        s->text[0] = 0;
        s->text_len = 1;
    }
    if (n == 0) return sp;
    int inside = p >= s->text && p < s->text + s->text_len;
    size_t from = inside ? (size_t)(p - s->text) : 0;
    store_layout_store_tag__text_room(s, n);
    if (inside) memmove(s->text + s->text_len, s->text + from, n);
    else memcpy(s->text + s->text_len, p, n);
    sp.off = (uint32_t)s->text_len;
    sp.len = (uint32_t)n;
    s->text_len += n;
    return sp;
}
const char *store_layout_store_tag_text_ptr(const store_layout_store_tag *s, amb_span sp) tie s {
    if (s->text_len == 0 || (size_t)sp.off + sp.len > s->text_len) abort();
    return s->text + sp.off;
}
int store_layout_store_tag_text_eq(const store_layout_store_tag *s, amb_span sp, const char *p, size_t n) {
    if (sp.len != n) return 0;
    if (n == 0) return 1;
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    return memcmp(s->text + sp.off, p, n) == 0;
}
void store_layout_store_tag_text_put(const store_layout_store_tag *s, FILE *out, amb_span sp) {
    if (sp.len == 0) { amb_put_qatom(out, "", 0); return; }
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    amb_put_qatom(out, s->text + sp.off, sp.len);
}
size_t store_layout_store_tag_text_size(const store_layout_store_tag *s) { return s->text_len; }
static void store_layout_store_tag__glyphs_room(store_layout_store_tag *s, size_t n) {
    if (s->glyphs_len + n <= s->glyphs_cap) return;
    size_t c = s->glyphs_cap ? s->glyphs_cap : 256;
    while (c < s->glyphs_len + n) c *= 2;
    if (c > 0x7FFFFFFF) abort();
    s->glyphs = (char *)realloc(s->glyphs, c);
    if (!s->glyphs) abort();
    s->glyphs_cap = c;
}
amb_span store_layout_store_tag_glyphs_add(store_layout_store_tag *s, const char *p, size_t n) {
    amb_span sp = { 0, 0 };
    if (s->glyphs_len == 0) {
        store_layout_store_tag__glyphs_room(s, 1);
        s->glyphs[0] = 0;
        s->glyphs_len = 1;
    }
    if (n == 0) return sp;
    int inside = p >= s->glyphs && p < s->glyphs + s->glyphs_len;
    size_t from = inside ? (size_t)(p - s->glyphs) : 0;
    store_layout_store_tag__glyphs_room(s, n);
    if (inside) memmove(s->glyphs + s->glyphs_len, s->glyphs + from, n);
    else memcpy(s->glyphs + s->glyphs_len, p, n);
    sp.off = (uint32_t)s->glyphs_len;
    sp.len = (uint32_t)n;
    s->glyphs_len += n;
    return sp;
}
const char *store_layout_store_tag_glyphs_ptr(const store_layout_store_tag *s, amb_span sp) tie s {
    if (s->glyphs_len == 0 || (size_t)sp.off + sp.len > s->glyphs_len) abort();
    return s->glyphs + sp.off;
}
int store_layout_store_tag_glyphs_eq(const store_layout_store_tag *s, amb_span sp, const char *p, size_t n) {
    if (sp.len != n) return 0;
    if (n == 0) return 1;
    if ((size_t)sp.off + sp.len > s->glyphs_len) abort();
    return memcmp(s->glyphs + sp.off, p, n) == 0;
}
void store_layout_store_tag_glyphs_put(const store_layout_store_tag *s, FILE *out, amb_span sp) {
    if (sp.len == 0) { amb_put_qatom(out, "", 0); return; }
    if ((size_t)sp.off + sp.len > s->glyphs_len) abort();
    amb_put_qatom(out, s->glyphs + sp.off, sp.len);
}
size_t store_layout_store_tag_glyphs_size(const store_layout_store_tag *s) { return s->glyphs_len; }
void store_layout_store_tag_children_append(store_layout_store_tag *s, uint32_t o, uint32_t i) {
    if (o == 0 || i == 0 || o >= s->box_len || i >= s->box_len) abort();
    uint32_t t = s->box[o].last_child;
    s->box[i].parent = o;
    s->box[i].next = 0;
    if (t) s->box[t].next = i; else s->box[o].first_child = i;
    s->box[o].last_child = i;
}

void store_layout_store_tag_children_insert_before(store_layout_store_tag *s, uint32_t o, uint32_t i, uint32_t b) {
    if (b == 0) { store_layout_store_tag_children_append(s, o, i); return; }
    if (o == 0 || i == 0 || o >= s->box_len || i >= s->box_len || b >= s->box_len || s->box[b].parent != o) abort();
    uint32_t p = 0;
    for (uint32_t x = s->box[o].first_child; x && x != b; x = s->box[x].next) p = x;
    s->box[i].parent = o;
    s->box[i].next = b;
    if (p) s->box[p].next = i; else s->box[o].first_child = i;
}

void store_layout_store_tag_children_unlink(store_layout_store_tag *s, uint32_t i) {
    if (i == 0 || i >= s->box_len) abort();
    uint32_t o = s->box[i].parent;
    if (o == 0) return;
    if (o >= s->box_len) abort();
    uint32_t n = s->box[i].next;
    uint32_t p = 0;
    for (uint32_t x = s->box[o].first_child; x && x != i; x = s->box[x].next) p = x;
    if (p) s->box[p].next = n; else s->box[o].first_child = n;
    if (s->box[o].last_child == i) s->box[o].last_child = p;
    s->box[i].parent = 0;
    s->box[i].next = 0;
}

uint32_t store_layout_store_tag_children_first(const store_layout_store_tag *s, uint32_t o) { if (o >= s->box_len) abort(); return s->box[o].first_child; }

uint32_t store_layout_store_tag_children_next(const store_layout_store_tag *s, uint32_t i) { if (i >= s->box_len) abort(); return s->box[i].next; }

uint32_t store_layout_store_tag_children_up(const store_layout_store_tag *s, uint32_t i) { if (i >= s->box_len) abort(); return s->box[i].parent; }

size_t store_layout_store_tag_children_count(const store_layout_store_tag *s, uint32_t o) {
    size_t n = 0;
    if (o >= s->box_len) abort();
    for (uint32_t i = s->box[o].first_child; i; i = s->box[i].next) {
        n++;
        if (n > s->box_len) abort();
    }
    return n;
}

int store_layout_store_tag_children_inclusive_ancestor(const store_layout_store_tag *s, uint32_t a, uint32_t b) {
    size_t steps = 0;
    for (uint32_t x = b; x; x = s->box[x].parent) {
        if (x >= s->box_len) abort();
        if (x == a) return 1;
        if (++steps > s->box_len) return 1;
    }
    return 0;
}

void store_layout_store_tag_lines_append(store_layout_store_tag *s, uint32_t o, uint32_t i) {
    if (o == 0 || i == 0 || o >= s->box_len || i >= s->line_len) abort();
    uint32_t t = s->box[o].last_line;
    s->line[i].box = o;
    s->line[i].next = 0;
    if (t) s->line[t].next = i; else s->box[o].first_line = i;
    s->box[o].last_line = i;
}

void store_layout_store_tag_lines_insert_before(store_layout_store_tag *s, uint32_t o, uint32_t i, uint32_t b) {
    if (b == 0) { store_layout_store_tag_lines_append(s, o, i); return; }
    if (o == 0 || i == 0 || o >= s->box_len || i >= s->line_len || b >= s->line_len || s->line[b].box != o) abort();
    uint32_t p = 0;
    for (uint32_t x = s->box[o].first_line; x && x != b; x = s->line[x].next) p = x;
    s->line[i].box = o;
    s->line[i].next = b;
    if (p) s->line[p].next = i; else s->box[o].first_line = i;
}

void store_layout_store_tag_lines_unlink(store_layout_store_tag *s, uint32_t i) {
    if (i == 0 || i >= s->line_len) abort();
    uint32_t o = s->line[i].box;
    if (o == 0) return;
    if (o >= s->box_len) abort();
    uint32_t n = s->line[i].next;
    uint32_t p = 0;
    for (uint32_t x = s->box[o].first_line; x && x != i; x = s->line[x].next) p = x;
    if (p) s->line[p].next = n; else s->box[o].first_line = n;
    if (s->box[o].last_line == i) s->box[o].last_line = p;
    s->line[i].box = 0;
    s->line[i].next = 0;
}

uint32_t store_layout_store_tag_lines_first(const store_layout_store_tag *s, uint32_t o) { if (o >= s->box_len) abort(); return s->box[o].first_line; }

uint32_t store_layout_store_tag_lines_next(const store_layout_store_tag *s, uint32_t i) { if (i >= s->line_len) abort(); return s->line[i].next; }

uint32_t store_layout_store_tag_lines_up(const store_layout_store_tag *s, uint32_t i) { if (i >= s->line_len) abort(); return s->line[i].box; }

size_t store_layout_store_tag_lines_count(const store_layout_store_tag *s, uint32_t o) {
    size_t n = 0;
    if (o >= s->box_len) abort();
    for (uint32_t i = s->box[o].first_line; i; i = s->line[i].next) {
