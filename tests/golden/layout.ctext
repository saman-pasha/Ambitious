        }
        for (uint32_t i = 1; i < d->frag_len; i++) {
            uint32_t r = d->frag[i].atomic;
            if (d->frag[i].live && r && (r >= d->box_len || !d->box[r].live)) { bad++; amb_report(report, "layout", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->frag_len; i++) {
            uint32_t r = d->frag[i].piece;
            if (d->frag[i].live && r && (r >= d->box_len || !d->box[r].live)) { bad++; amb_report(report, "layout", "live_links", i); }
        }
    }
    return bad;
}
void layout_export(const layout_tree *d, FILE *out) {
    fprintf(out, "amb_snapshot(layout, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, layout_fingerprint);
    for (uint32_t i = 1; i < d->box_len; i++) {
        if (!d->box[i].live) continue;
        if (1) { fputs("layout_box(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); amb_put_ref(out, "n", d->box[i].node.doc, d->box[i].node.index, d->box[i].node.gen); fputs(",", out); fputs(layout_box_kind_name(d->box[i].kind), out); fputs(",", out); amb_put_f64(out, d->box[i].x); fputs(",", out); amb_put_f64(out, d->box[i].y); fputs(",", out); amb_put_f64(out, d->box[i].w); fputs(",", out); amb_put_f64(out, d->box[i].h); fputs(").\n", out); }
        if (d->box[i].parent != 0) { fputs("layout_parent(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); { uint32_t r = d->box[i].parent; amb_put_ref(out, "bx", d->id, r, r && r < d->box_len ? d->box[r].gen : 0); } fputs(").\n", out); }
        if (d->box[i].pseudo != 0) { fputs("layout_pseudo(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].pseudo); fputs(").\n", out); }
        if (d->box[i].position != LAYOUT_POSITION_STATIC) { fputs("layout_positioned(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); fputs(layout_position_name(d->box[i].position), out); fputs(",", out); { uint32_t r = d->box[i].cb; amb_put_ref(out, "bx", d->id, r, r && r < d->box_len ? d->box[r].gen : 0); } fputs(",", out); amb_put_f64(out, d->box[i].dx); fputs(",", out); amb_put_f64(out, d->box[i].dy); fputs(").\n", out); }
        if (d->box[i].cb_inline == 1) { fputs("layout_inline_cb(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); amb_put_ref(out, "n", d->box[i].cb_node.doc, d->box[i].cb_node.index, d->box[i].cb_node.gen); fputs(").\n", out); }
        if (d->box[i].z_auto == 0) { fputs("layout_stacking(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].z); fputs(").\n", out); }
        if (d->box[i].float_side != LAYOUT_FLOAT_SIDE_UNFLOATED) { fputs("layout_float(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); fputs(layout_float_side_name(d->box[i].float_side), out); fputs(").\n", out); }
        if (d->box[i].grid_by != LAYOUT_GRID_BY_UNGRIDDED) { fputs("layout_grid_item(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].grid_row); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].grid_col); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].grid_rows); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].grid_cols); fputs(",", out); fputs(layout_grid_by_name(d->box[i].grid_by), out); fputs(").\n", out); }
        if (d->box[i].grid_by == LAYOUT_GRID_BY_AREA) { fputs("layout_grid_area(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); text_put(d, out, d->box[i].grid_area); fputs(").\n", out); }
        if (d->box[i].clip != 0) { fputs("layout_clips(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(").\n", out); }
        if (d->box[i].background != 0) { fputs("layout_background(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->box[i].background); fputs(").\n", out); }
        if (1) { fputs("layout_margin(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); amb_put_f64(out, d->box[i].mt); fputs(",", out); amb_put_f64(out, d->box[i].mr); fputs(",", out); amb_put_f64(out, d->box[i].mb); fputs(",", out); amb_put_f64(out, d->box[i].ml); fputs(").\n", out); }
        if (1) { fputs("layout_border(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); amb_put_f64(out, d->box[i].bt); fputs(",", out); amb_put_f64(out, d->box[i].br); fputs(",", out); amb_put_f64(out, d->box[i].bb); fputs(",", out); amb_put_f64(out, d->box[i].bl); fputs(").\n", out); }
        if (1) { fputs("layout_padding(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); amb_put_f64(out, d->box[i].pt); fputs(",", out); amb_put_f64(out, d->box[i].pr); fputs(",", out); amb_put_f64(out, d->box[i].pb); fputs(",", out); amb_put_f64(out, d->box[i].pl); fputs(").\n", out); }
        if (1) { fputs("layout_width(", out); amb_put_handle(out, "bx", d->id, i, d->box[i].gen); fputs(",", out); amb_put_f64(out, d->box[i].w); fputs(",", out); fputs(layout_width_how_name(d->box[i].how), out); fputs(",", out); amb_put_f64(out, d->box[i].avail); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->line_len; i++) {
        if (!d->line[i].live) continue;
        if (1) { fputs("layout_line(", out); amb_put_handle(out, "ln", d->id, i, d->line[i].gen); fputs(",", out); { uint32_t r = d->line[i].box; amb_put_ref(out, "bx", d->id, r, r && r < d->box_len ? d->box[r].gen : 0); } fputs(",", out); amb_put_f64(out, d->line[i].x); fputs(",", out); amb_put_f64(out, d->line[i].y); fputs(",", out); amb_put_f64(out, d->line[i].w); fputs(",", out); amb_put_f64(out, d->line[i].h); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->frag_len; i++) {
        if (!d->frag[i].live) continue;
        if (d->frag[i].kind == LAYOUT_FRAG_KIND_TEXT) { fputs("layout_text(", out); amb_put_handle(out, "fr", d->id, i, d->frag[i].gen); fputs(",", out); { uint32_t r = d->frag[i].line; amb_put_ref(out, "ln", d->id, r, r && r < d->line_len ? d->line[r].gen : 0); } fputs(",", out); amb_put_ref(out, "n", d->frag[i].node.doc, d->frag[i].node.index, d->frag[i].node.gen); fputs(",", out); text_put(d, out, d->frag[i].text); fputs(",", out); amb_put_f64(out, d->frag[i].x); fputs(",", out); amb_put_f64(out, d->frag[i].y); fputs(",", out); amb_put_f64(out, d->frag[i].w); fputs(",", out); amb_put_f64(out, d->frag[i].h); fputs(").\n", out); }
        if (d->frag[i].kind != LAYOUT_FRAG_KIND_TEXT) { fputs("layout_frag(", out); amb_put_handle(out, "fr", d->id, i, d->frag[i].gen); fputs(",", out); { uint32_t r = d->frag[i].line; amb_put_ref(out, "ln", d->id, r, r && r < d->line_len ? d->line[r].gen : 0); } fputs(",", out); fputs(layout_frag_kind_name(d->frag[i].kind), out); fputs(",", out); amb_put_ref(out, "n", d->frag[i].node.doc, d->frag[i].node.index, d->frag[i].node.gen); fputs(",", out); amb_put_f64(out, d->frag[i].x); fputs(",", out); amb_put_f64(out, d->frag[i].y); fputs(",", out); amb_put_f64(out, d->frag[i].w); fputs(",", out); amb_put_f64(out, d->frag[i].h); fputs(").\n", out); }
        if (d->frag[i].kind == LAYOUT_FRAG_KIND_GENERATED) { fputs("layout_generated(", out); amb_put_handle(out, "fr", d->id, i, d->frag[i].gen); fputs(",", out); amb_put_ref(out, "n", d->frag[i].node.doc, d->frag[i].node.index, d->frag[i].node.gen); fputs(",", out); text_put(d, out, d->frag[i].text); fputs(").\n", out); }
    }
}
layout_status layout_dispatch(layout_tree *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    layout_status st = LAYOUT_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return LAYOUT_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return LAYOUT_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return LAYOUT_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return LAYOUT_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return LAYOUT_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return LAYOUT_STALE_REVISION; }

    if (amb_name_is(name, name_len, "run")) { amb_result(report, name, "not_requestable", d->revision); return LAYOUT_NOT_REQUESTABLE; }
    amb_result(report, name, "bad_request", d->revision);
    return st;
}
/* the store of module layout, an instance of store<layout_store_tag>: one own buffer a part */
typedef struct store_layout_store_tag {
    uint32_t id;
    uint64_t revision;
    size_t box_len, box_cap;
    uint32_t box_free;
    own layout_box *box;
    size_t line_len, line_cap;
    uint32_t line_free;
    own layout_line *line;
    size_t frag_len, frag_cap;
    uint32_t frag_free;
    own layout_frag *frag;
    size_t text_len, text_cap;
    own char *text;
    size_t glyphs_len, glyphs_cap;
    own char *glyphs;
} store_layout_store_tag;
void store_layout_store_tag_drop(store_layout_store_tag *s) { free(s->box); free(s->line); free(s->frag); free(s->text); free(s->glyphs); }
static void store_layout_store_tag__box_grow(store_layout_store_tag *s) {
    size_t c = s->box_cap ? 2 * s->box_cap : 16;
    if (c > 0x7FFFFFFF) abort();
    s->box = (layout_box *)realloc(s->box, c * sizeof(layout_box));
    if (!s->box) abort();
    s->box_cap = c;
}
layout_box_h store_layout_store_tag_box_new(store_layout_store_tag *s) {
    uint32_t i;
    if (s->box_free) {
        i = s->box_free;
        s->box_free = s->box[i].free_next;
    } else {
        if (s->box_len == 0) {
            if (s->box_cap == 0) store_layout_store_tag__box_grow(s);
            memset(&s->box[0], 0, sizeof(layout_box));
            s->box_len = 1;
        }
        if (s->box_len == s->box_cap) store_layout_store_tag__box_grow(s);
        i = (uint32_t)s->box_len;
        s->box_len++;
        s->box[i].gen = 0;
    }
    uint32_t g = s->box[i].gen;
    memset(&s->box[i], 0, sizeof(layout_box));
    s->box[i].gen = g;
    s->box[i].live = 1;
    layout_box_h h = { s->id, i, g };
    return h;
}
int store_layout_store_tag_box_live(const store_layout_store_tag *s, layout_box_h h) {
    return h.doc == s->id && h.index != 0 && h.index < s->box_len && s->box[h.index].live && s->box[h.index].gen == h.gen;
}
layout_box store_layout_store_tag_box_get(const store_layout_store_tag *s, layout_box_h h) {
    if (!store_layout_store_tag_box_live(s, h)) abort();
    return s->box[h.index];
}
layout_box *store_layout_store_tag_box_ref(const store_layout_store_tag *s, layout_box_h h) tie s {
    if (!store_layout_store_tag_box_live(s, h)) abort();
    return &s->box[h.index];
}
layout_box *store_layout_store_tag_box_slot(const store_layout_store_tag *s, uint32_t i) tie s {
    if (i == 0 || i >= s->box_len) abort();
    return &s->box[i];
}
layout_box_h store_layout_store_tag_box_handle(const store_layout_store_tag *s, uint32_t i) {
    layout_box_h h = { 0, 0, 0 };
    if (i != 0 && i < s->box_len && s->box[i].live) {
        h.doc = s->id;
        h.index = i;
        h.gen = s->box[i].gen;
    }
    return h;
}
void store_layout_store_tag_box_free(store_layout_store_tag *s, layout_box_h h) {
    if (!store_layout_store_tag_box_live(s, h)) abort();
    s->box[h.index].live = 0;
    s->box[h.index].gen++;
    s->box[h.index].free_next = s->box_free;
    s->box_free = h.index;
}
size_t store_layout_store_tag_box_len(const store_layout_store_tag *s) { return s->box_len; }
size_t store_layout_store_tag_box_count(const store_layout_store_tag *s) {
    size_t n = 0;
    for (size_t i = 1; i < s->box_len; i++) if (s->box[i].live) n++;
    return n;
}
