net_schema(derived(net_secure/2,'a resource got over TLS from a verified server, and the TLS version')).
net_schema(derived(net_mixed_content/2,'a part that a page served over TLS got over http:')).
net_schema(derived(net_cookies_sent/2,'the names of the cookies sent for a resource, in the order sent')).
net_schema(derived(net_third_party_cookie/2,'a cookie sent for a resource of another site than the page\'s')).
