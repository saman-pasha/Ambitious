%% build/schema/net.pl -- the reasoning schema of net, generated by tools/amb from contracts/net.pl.
%% Do not edit: change the contract and run `make schema`.
net_schema(module(net,'0.1.0','fnv1a32:1d8e9afc:2443')).
net_schema(summary('Networking: URLs resolved, resources fetched over file:, data: and http:, what a page loaded, why, and from where')).
net_schema(handle(resource,rs)).
net_schema(handle(hop,hp)).
net_schema(enum(kind,[document,stylesheet,image,script,other])).
net_schema(enum(outcome,[ok,http_error,no_such_file,refused,unreachable,too_many_redirects,unsupported_scheme,bad_url,blocked,too_large,malformed])).
net_schema(status([ok,stale_handle,wrong_kind,failed])).
net_schema(fact(net_resource/7,[handle(resource),atom,enum(kind),enum(outcome),integer,atom,integer])).
net_schema(fact(net_final_url/2,[handle(resource),atom])).
net_schema(fact(net_origin/2,[handle(resource),atom])).
net_schema(fact(net_asked_by/3,[handle(resource),handle_or_none(resource),xhandle(dom,node)])).
net_schema(fact(net_hop/3,[handle_or_none(resource),atom,integer])).
net_schema(fact(net_image_size/3,[handle(resource),integer,integer])).
net_schema(derived(net_page/1,'a document fetched as a page')).
net_schema(derived(net_depends/2,'a resource the page needs, directly or through another')).
net_schema(derived(net_cross_origin/2,'a resource from another origin than the page that asked for it, neither opaque')).
net_schema(derived(net_failed/2,'a resource whose fetch did not end well, and how it ended')).
net_schema(derived(net_redirects/2,'the URLs a resource was redirected through, in order')).
net_schema(rules('rules/net')).
net_schema(operation(fetch,[text,enum(kind)],handle(resource),[mutates])).
net_schema(operation(fetch_subresources,[store(dom),handle(resource),u32],status,[mutates])).
net_schema(query(loaded,net_resource(A,B,C,D,E,_,_),[A,B,C,D,E],'every resource, what it is and how its fetch ended')).
