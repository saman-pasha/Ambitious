%% build/schema/script.pl -- the reasoning schema of script, generated by tools/amb from contracts/script.pl.
%% Do not edit: change the contract and run `make schema`.
script_schema(module(script,'0.1.0','fnv1a32:8778d33a:2965')).
script_schema(summary('Scripts: what a page\'s scripts ran, wrote, threw, listened for and scheduled')).
script_schema(handle(run,sr)).
script_schema(handle(console,sc)).
script_schema(handle(error,se)).
script_schema(handle(listener,sl)).
script_schema(handle(timer,st)).
script_schema(enum(source,[inline,external,attribute])).
script_schema(enum(outcome,[ran,threw,syntax_error,stopped,not_fetched,not_run])).
script_schema(enum(level,[log,info,warn,error,debug])).
script_schema(enum(phase,[script,event,timer])).
script_schema(enum(listen_on,[node,window])).
script_schema(enum(timer_state,[fired,cleared,pending])).
script_schema(status([ok,stale_handle,wrong_kind,failed])).
script_schema(fact(script_run/4,[handle(run),xhandle(dom,node),enum(source),enum(outcome)])).
script_schema(fact(script_url/2,[handle(run),atom])).
script_schema(fact(script_console/3,[handle_or_none(run),enum(level),atom])).
script_schema(fact(script_error/3,[handle_or_none(run),enum(phase),atom])).
script_schema(fact(script_listener/3,[xhandle(dom,node),atom,handle_or_none(run)])).
script_schema(fact(script_window_listener/2,[atom,handle_or_none(run)])).
script_schema(fact(script_capture/2,[xhandle(dom,node),atom])).
script_schema(fact(script_timer/4,[handle(timer),integer,enum_values([true,false]),enum(timer_state)])).
script_schema(fact(script_timer_of/2,[handle(timer),handle_or_none(run)])).
script_schema(derived(script_failed/2,'a script that did not run to its end, and how it ended')).
script_schema(derived(script_uncaught/3,'an error no code caught: the script, where it was thrown, its message')).
script_schema(derived(script_click_unfocusable/2,'an element with a click listener that a keyboard cannot reach, and its name')).
script_schema(derived(script_unsettled/2,'a timer still set when the page came to rest, and the script that set it')).
script_schema(derived(script_listens/3,'an element, an event it is listened for on, and the script whose listener')).
script_schema(rules('rules/script')).
script_schema(query(errors,script_uncaught(A,B,C),[A,B,C],'every error no code caught')).
script_schema(query(listeners,script_listens(A,B,C),[A,B,C],'every element listened on, for what, by which script')).
