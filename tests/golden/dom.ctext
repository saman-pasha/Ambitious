dom_status dom_check_append_child(const dom_document *d, dom_node_h parent, dom_node_h child)
{
    if (!node_live(d, parent)) return DOM_STALE_HANDLE;
    if (!node_live(d, child)) return DOM_STALE_HANDLE;
    { dom_node_kind k = d->node[parent.index].kind; if (!(k == DOM_NODE_KIND_DOCUMENT || k == DOM_NODE_KIND_ELEMENT || k == DOM_NODE_KIND_FRAGMENT)) return DOM_WRONG_KIND; }
    { dom_node_kind k = d->node[child.index].kind; if (!(k == DOM_NODE_KIND_DOCTYPE || k == DOM_NODE_KIND_ELEMENT || k == DOM_NODE_KIND_TEXT || k == DOM_NODE_KIND_COMMENT)) return DOM_WRONG_KIND; }
    if (d->node[child.index].parent != 0) return DOM_HAS_PARENT;
    if (children_inclusive_ancestor(d, child.index, parent.index)) return DOM_WOULD_CYCLE;
    return DOM_OK;
}

dom_status dom_check_insert_before(const dom_document *d, dom_node_h parent, dom_node_h child, dom_node_h before)
{
    if (!node_live(d, parent)) return DOM_STALE_HANDLE;
    if (!node_live(d, child)) return DOM_STALE_HANDLE;
    if (!node_live(d, before)) return DOM_STALE_HANDLE;
    { dom_node_kind k = d->node[parent.index].kind; if (!(k == DOM_NODE_KIND_DOCUMENT || k == DOM_NODE_KIND_ELEMENT || k == DOM_NODE_KIND_FRAGMENT)) return DOM_WRONG_KIND; }
    { dom_node_kind k = d->node[child.index].kind; if (!(k == DOM_NODE_KIND_DOCTYPE || k == DOM_NODE_KIND_ELEMENT || k == DOM_NODE_KIND_TEXT || k == DOM_NODE_KIND_COMMENT)) return DOM_WRONG_KIND; }
    if (d->node[child.index].parent != 0) return DOM_HAS_PARENT;
    if (d->node[before.index].parent != parent.index) return DOM_NOT_A_CHILD;
    if (children_inclusive_ancestor(d, child.index, parent.index)) return DOM_WOULD_CYCLE;
    return DOM_OK;
}

dom_status dom_check_remove_child(const dom_document *d, dom_node_h parent, dom_node_h child)
{
    if (!node_live(d, parent)) return DOM_STALE_HANDLE;
    if (!node_live(d, child)) return DOM_STALE_HANDLE;
    if (d->node[child.index].parent != parent.index) return DOM_NOT_A_CHILD;
    return DOM_OK;
}

dom_status dom_check_destroy(const dom_document *d, dom_node_h node)
