void dom_log_mutation(dom_document *d, dom_op op, uint32_t target, uint32_t other, uint32_t detail) {
    d->revision++;
    dom_mutation e = { op, target, other, detail, d->revision };
    mutation_push(d, e);
}
int dom_check_invariants(const dom_document *d, FILE *report) {
    int bad = 0;
    /* root_document */
    if (d->node_len < 2 || !d->node[1].live || d->node[1].kind != DOM_NODE_KIND_DOCUMENT || d->node[1].parent != 0) { bad++; amb_report(report, "dom", "root_document", 1); }
    /* tree_links */
    {
        own uint32_t *seen = (uint32_t *)calloc(d->node_len ? d->node_len : 1, sizeof(uint32_t));
        if (!seen) abort();
        for (uint32_t o = 1; o < d->node_len; o++) {
            if (!d->node[o].live) continue;
            uint32_t prev = 0;
            size_t steps = 0;
            for (uint32_t i = d->node[o].first_child; i; i = d->node[i].next_sibling) {
                if (i >= d->node_len || !d->node[i].live || d->node[i].parent != o || ++steps > d->node_len || seen[i]) { bad++; amb_report(report, "dom", "tree_links", o); break; }
                seen[i] = o;
            if (d->node[i].prev_sibling != prev) { bad++; amb_report(report, "dom", "tree_links", i); }
                prev = i;
            }
        if (d->node[o].last_child != prev) { bad++; amb_report(report, "dom", "tree_links", o); }
        }
        for (uint32_t i = 1; i < d->node_len; i++)
            if (d->node[i].live && d->node[i].parent && seen[i] != d->node[i].parent) { bad++; amb_report(report, "dom", "tree_links", i); }
        free(seen);
    }
    /* acyclic */
    for (uint32_t i = 1; i < d->node_len; i++) {
        if (!d->node[i].live) continue;
        size_t steps = 0;
        for (uint32_t x = d->node[i].parent; x; x = x < d->node_len ? d->node[x].parent : 0) {
            if (x == i || ++steps > d->node_len) { bad++; amb_report(report, "dom", "acyclic", i); break; }
        }
    }
    /* only_containers */
    for (uint32_t o = 1; o < d->node_len; o++) {
        if (!d->node[o].live || !d->node[o].first_child) continue;
        dom_node_kind k = d->node[o].kind;
        if (!(k == DOM_NODE_KIND_DOCUMENT || k == DOM_NODE_KIND_ELEMENT || k == DOM_NODE_KIND_FRAGMENT)) { bad++; amb_report(report, "dom", "only_containers", o); }
    }
    for (uint32_t i = 1; i < d->node_len; i++) {
        if (!d->node[i].live || !d->node[i].parent || d->node[i].parent >= d->node_len) continue;
        dom_node_kind k = d->node[d->node[i].parent].kind;
        if (!(k == DOM_NODE_KIND_DOCUMENT || k == DOM_NODE_KIND_ELEMENT || k == DOM_NODE_KIND_FRAGMENT)) { bad++; amb_report(report, "dom", "only_containers", i); }
    }
    /* attr_links */
    {
        own uint32_t *seen = (uint32_t *)calloc(d->attr_len ? d->attr_len : 1, sizeof(uint32_t));
        if (!seen) abort();
        for (uint32_t o = 1; o < d->node_len; o++) {
            if (!d->node[o].live) continue;
            uint32_t prev = 0;
            size_t steps = 0;
            for (uint32_t i = d->node[o].first_attr; i; i = d->attr[i].next) {
                if (i >= d->attr_len || !d->attr[i].live || d->attr[i].owner != o || ++steps > d->attr_len || seen[i]) { bad++; amb_report(report, "dom", "attr_links", o); break; }
                seen[i] = o;
                prev = i;
            }
        }
        for (uint32_t i = 1; i < d->attr_len; i++)
            if (d->attr[i].live && d->attr[i].owner && seen[i] != d->attr[i].owner) { bad++; amb_report(report, "dom", "attr_links", i); }
        free(seen);
    }
    /* attr_owners */
    for (uint32_t o = 1; o < d->node_len; o++) {
        if (!d->node[o].live || !d->node[o].first_attr) continue;
        dom_node_kind k = d->node[o].kind;
        if (!(k == DOM_NODE_KIND_ELEMENT)) { bad++; amb_report(report, "dom", "attr_owners", o); }
    }
    for (uint32_t i = 1; i < d->attr_len; i++) {
        if (!d->attr[i].live || !d->attr[i].owner || d->attr[i].owner >= d->node_len) continue;
        dom_node_kind k = d->node[d->attr[i].owner].kind;
        if (!(k == DOM_NODE_KIND_ELEMENT)) { bad++; amb_report(report, "dom", "attr_owners", i); }
    }
    /* live_links */
    {
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].parent;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].first_child;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].last_child;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].prev_sibling;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].next_sibling;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].first_attr;
            if (d->node[i].live && r && (r >= d->attr_len || !d->attr[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].content;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->node_len; i++) {
            uint32_t r = d->node[i].host;
            if (d->node[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->attr_len; i++) {
            uint32_t r = d->attr[i].owner;
            if (d->attr[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->attr_len; i++) {
            uint32_t r = d->attr[i].next;
            if (d->attr[i].live && r && (r >= d->attr_len || !d->attr[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->shadow_len; i++) {
            uint32_t r = d->shadow[i].host;
            if (d->shadow[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->shadow_len; i++) {
            uint32_t r = d->shadow[i].root;
            if (d->shadow[i].live && r && (r >= d->node_len || !d->node[r].live)) { bad++; amb_report(report, "dom", "live_links", i); }
        }
    }
    return bad;
}
void dom_export(const dom_document *d, FILE *out) {
    fprintf(out, "amb_snapshot(dom, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, dom_fingerprint);
    for (uint32_t i = 1; i < d->node_len; i++) {
        if (!d->node[i].live) continue;
        if (1) { fputs("dom_node(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); fputs(dom_node_kind_name(d->node[i].kind), out); fputs(").\n", out); }
        if (d->node[i].kind == DOM_NODE_KIND_ELEMENT) { fputs("dom_element(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); names_put(d, out, d->node[i].name); fputs(").\n", out); }
        if (d->node[i].kind == DOM_NODE_KIND_TEXT) { fputs("dom_text(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); text_put(d, out, d->node[i].data); fputs(").\n", out); }
        if (d->node[i].kind == DOM_NODE_KIND_COMMENT) { fputs("dom_comment(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); text_put(d, out, d->node[i].data); fputs(").\n", out); }
        if (d->node[i].kind == DOM_NODE_KIND_DOCTYPE) { fputs("dom_doctype(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); names_put(d, out, d->node[i].name); fputs(").\n", out); }
        if (d->node[i].parent != 0) { fputs("dom_parent(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); { uint32_t r = d->node[i].parent; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(").\n", out); }
        if (d->node[i].next_sibling != 0) { fputs("dom_next_sibling(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); { uint32_t r = d->node[i].next_sibling; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(").\n", out); }
        if (d->node[i].first_child != 0) { fputs("dom_first_child(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); { uint32_t r = d->node[i].first_child; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(").\n", out); }
        if ((d->node[i].kind == DOM_NODE_KIND_ELEMENT) && (d->node[i].ns != DOM_NAMESPACE_HTML)) { fputs("dom_namespace(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); fputs(dom_namespace_name(d->node[i].ns), out); fputs(").\n", out); }
        if (d->node[i].content != 0) { fputs("dom_template_content(", out); amb_put_handle(out, "n", d->id, i, d->node[i].gen); fputs(",", out); { uint32_t r = d->node[i].content; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->attr_len; i++) {
        if (!d->attr[i].live) continue;
        if (1) { fputs("dom_attr(", out); { uint32_t r = d->attr[i].owner; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(",", out); names_put(d, out, d->attr[i].name); fputs(",", out); text_put(d, out, d->attr[i].value); fputs(").\n", out); }
        if (d->attr[i].ns != DOM_ATTR_NAMESPACE_NULL) { fputs("dom_attr_namespace(", out); { uint32_t r = d->attr[i].owner; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(",", out); names_put(d, out, d->attr[i].name); fputs(",", out); fputs(dom_attr_namespace_name(d->attr[i].ns), out); fputs(").\n", out); }
    }

    for (uint32_t i = 1; i < d->shadow_len; i++) {
        if (!d->shadow[i].live) continue;
        if (1) { fputs("dom_shadow_root(", out); { uint32_t r = d->shadow[i].host; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(",", out); { uint32_t r = d->shadow[i].root; amb_put_ref(out, "n", d->id, r, r && r < d->node_len ? d->node[r].gen : 0); } fputs(",", out); fputs(dom_shadow_mode_name(d->shadow[i].mode), out); fputs(").\n", out); }
    }
}
dom_status dom_dispatch(dom_document *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    dom_status st = DOM_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return DOM_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return DOM_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return DOM_STALE_REVISION; }
    if (amb_name_is(name, name_len, "append_child")) {
        dom_node_h a_parent = { 0, 0, 0 };
        dom_node_h a_child = { 0, 0, 0 };
        if (!amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_parent.doc, &a_parent.index, &a_parent.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_child.doc, &a_child.index, &a_child.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')')) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')') || !amb_lex_char(t, n, &p, '.') || !amb_lex_end(t, n, &p)) return DOM_BAD_REQUEST;
        st = dom_append_child(d, a_parent, a_child);
        amb_result(report, name, dom_status_name(st), d->revision);
        return st;
    }
    if (amb_name_is(name, name_len, "insert_before")) {
        dom_node_h a_parent = { 0, 0, 0 };
        dom_node_h a_child = { 0, 0, 0 };
        dom_node_h a_before = { 0, 0, 0 };
        if (!amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_parent.doc, &a_parent.index, &a_parent.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_child.doc, &a_child.index, &a_child.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_before.doc, &a_before.index, &a_before.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')')) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')') || !amb_lex_char(t, n, &p, '.') || !amb_lex_end(t, n, &p)) return DOM_BAD_REQUEST;
        st = dom_insert_before(d, a_parent, a_child, a_before);
        amb_result(report, name, dom_status_name(st), d->revision);
        return st;
    }
    if (amb_name_is(name, name_len, "remove_child")) {
        dom_node_h a_parent = { 0, 0, 0 };
        dom_node_h a_child = { 0, 0, 0 };
        if (!amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_parent.doc, &a_parent.index, &a_parent.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_child.doc, &a_child.index, &a_child.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')')) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')') || !amb_lex_char(t, n, &p, '.') || !amb_lex_end(t, n, &p)) return DOM_BAD_REQUEST;
        st = dom_remove_child(d, a_parent, a_child);
        amb_result(report, name, dom_status_name(st), d->revision);
        return st;
    }
    if (amb_name_is(name, name_len, "set_attribute")) {
        dom_node_h a_element = { 0, 0, 0 };
        char a_name[4096];
        size_t a_name_len = 0;
        char a_value[4096];
        size_t a_value_len = 0;
        if (!amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_element.doc, &a_element.index, &a_element.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_atom(t, n, &p, a_name, sizeof a_name, &a_name_len)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_atom(t, n, &p, a_value, sizeof a_value, &a_value_len)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')')) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')') || !amb_lex_char(t, n, &p, '.') || !amb_lex_end(t, n, &p)) return DOM_BAD_REQUEST;
        st = dom_set_attribute(d, a_element, a_name, a_name_len, a_value, a_value_len);
        amb_result(report, name, dom_status_name(st), d->revision);
        return st;
    }
    if (amb_name_is(name, name_len, "remove_attribute")) {
        dom_node_h a_element = { 0, 0, 0 };
        char a_name[4096];
        size_t a_name_len = 0;
        if (!amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_element.doc, &a_element.index, &a_element.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_atom(t, n, &p, a_name, sizeof a_name, &a_name_len)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')')) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')') || !amb_lex_char(t, n, &p, '.') || !amb_lex_end(t, n, &p)) return DOM_BAD_REQUEST;
        st = dom_remove_attribute(d, a_element, a_name, a_name_len);
        amb_result(report, name, dom_status_name(st), d->revision);
        return st;
    }
    if (amb_name_is(name, name_len, "set_data")) {
        dom_node_h a_node = { 0, 0, 0 };
        char a_data[4096];
        size_t a_data_len = 0;
        if (!amb_lex_char(t, n, &p, '(')) return DOM_BAD_REQUEST;
        if (!amb_lex_handle(t, n, &p, "n", &a_node.doc, &a_node.index, &a_node.gen)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ',')) return DOM_BAD_REQUEST;
        if (!amb_lex_atom(t, n, &p, a_data, sizeof a_data, &a_data_len)) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')')) return DOM_BAD_REQUEST;
        if (!amb_lex_char(t, n, &p, ')') || !amb_lex_char(t, n, &p, '.') || !amb_lex_end(t, n, &p)) return DOM_BAD_REQUEST;
        st = dom_set_data(d, a_node, a_data, a_data_len);
        amb_result(report, name, dom_status_name(st), d->revision);
        return st;
    }
    if (amb_name_is(name, name_len, "create_element") || amb_name_is(name, name_len, "create_element_ns") || amb_name_is(name, name_len, "create_text") || amb_name_is(name, name_len, "create_comment") || amb_name_is(name, name_len, "create_doctype") || amb_name_is(name, name_len, "destroy") || amb_name_is(name, name_len, "set_attribute_ns") || amb_name_is(name, name_len, "attach_shadow") || amb_name_is(name, name_len, "keep_details") || amb_name_is(name, name_len, "serialize")) { amb_result(report, name, "not_requestable", d->revision); return DOM_NOT_REQUESTABLE; }
    amb_result(report, name, "bad_request", d->revision);
    return st;
}
/* the store of module dom, an instance of store<dom_store_tag>: one own buffer a part */
typedef struct store_dom_store_tag {
    uint32_t id;
    uint64_t revision;
    size_t node_len, node_cap;
    uint32_t node_free;
    own dom_node *node;
    size_t attr_len, attr_cap;
    uint32_t attr_free;
    own dom_attr *attr;
    size_t text_len, text_cap;
    own char *text;
    size_t names_len, names_cap, names_n, names_ncap, names_scap;
    own char *names;
    own amb_span *names_at;
    own uint32_t *names_slots;
    size_t mutation_len, mutation_cap;
    own dom_mutation *mutation;
    size_t detail_len, detail_cap;
    uint32_t detail_free;
    own dom_detail *detail;
    size_t shadow_len, shadow_cap;
    uint32_t shadow_free;
    own dom_shadow *shadow;
} store_dom_store_tag;
void store_dom_store_tag_drop(store_dom_store_tag *s) { free(s->node); free(s->attr); free(s->text); free(s->names); free(s->names_at); free(s->names_slots); free(s->mutation); free(s->detail); free(s->shadow); }
static void store_dom_store_tag__node_grow(store_dom_store_tag *s) {
    size_t c = s->node_cap ? 2 * s->node_cap : 16;
    if (c > 0x7FFFFFFF) abort();
    s->node = (dom_node *)realloc(s->node, c * sizeof(dom_node));
    if (!s->node) abort();
    s->node_cap = c;
}
dom_node_h store_dom_store_tag_node_new(store_dom_store_tag *s) {
    uint32_t i;
    if (s->node_free) {
        i = s->node_free;
        s->node_free = s->node[i].free_next;
    } else {
        if (s->node_len == 0) {
            if (s->node_cap == 0) store_dom_store_tag__node_grow(s);
            memset(&s->node[0], 0, sizeof(dom_node));
            s->node_len = 1;
        }
        if (s->node_len == s->node_cap) store_dom_store_tag__node_grow(s);
        i = (uint32_t)s->node_len;
        s->node_len++;
        s->node[i].gen = 0;
    }
    uint32_t g = s->node[i].gen;
    memset(&s->node[i], 0, sizeof(dom_node));
    s->node[i].gen = g;
    s->node[i].live = 1;
    dom_node_h h = { s->id, i, g };
    return h;
}
int store_dom_store_tag_node_live(const store_dom_store_tag *s, dom_node_h h) {
    return h.doc == s->id && h.index != 0 && h.index < s->node_len && s->node[h.index].live && s->node[h.index].gen == h.gen;
}
dom_node store_dom_store_tag_node_get(const store_dom_store_tag *s, dom_node_h h) {
    if (!store_dom_store_tag_node_live(s, h)) abort();
    return s->node[h.index];
}
dom_node *store_dom_store_tag_node_ref(const store_dom_store_tag *s, dom_node_h h) tie s {
    if (!store_dom_store_tag_node_live(s, h)) abort();
    return &s->node[h.index];
}
dom_node *store_dom_store_tag_node_slot(const store_dom_store_tag *s, uint32_t i) tie s {
    if (i == 0 || i >= s->node_len) abort();
    return &s->node[i];
}
dom_node_h store_dom_store_tag_node_handle(const store_dom_store_tag *s, uint32_t i) {
    dom_node_h h = { 0, 0, 0 };
    if (i != 0 && i < s->node_len && s->node[i].live) {
        h.doc = s->id;
        h.index = i;
        h.gen = s->node[i].gen;
    }
    return h;
}
void store_dom_store_tag_node_free(store_dom_store_tag *s, dom_node_h h) {
    if (!store_dom_store_tag_node_live(s, h)) abort();
    s->node[h.index].live = 0;
    s->node[h.index].gen++;
    s->node[h.index].free_next = s->node_free;
    s->node_free = h.index;
}
size_t store_dom_store_tag_node_len(const store_dom_store_tag *s) { return s->node_len; }
size_t store_dom_store_tag_node_count(const store_dom_store_tag *s) {
    size_t n = 0;
    for (size_t i = 1; i < s->node_len; i++) if (s->node[i].live) n++;
    return n;
}
static void store_dom_store_tag__attr_grow(store_dom_store_tag *s) {
    size_t c = s->attr_cap ? 2 * s->attr_cap : 16;
    if (c > 0x7FFFFFFF) abort();
    s->attr = (dom_attr *)realloc(s->attr, c * sizeof(dom_attr));
    if (!s->attr) abort();
    s->attr_cap = c;
}
dom_attr_h store_dom_store_tag_attr_new(store_dom_store_tag *s) {
    uint32_t i;
    if (s->attr_free) {
        i = s->attr_free;
        s->attr_free = s->attr[i].free_next;
    } else {
        if (s->attr_len == 0) {
            if (s->attr_cap == 0) store_dom_store_tag__attr_grow(s);
            memset(&s->attr[0], 0, sizeof(dom_attr));
            s->attr_len = 1;
        }
        if (s->attr_len == s->attr_cap) store_dom_store_tag__attr_grow(s);
        i = (uint32_t)s->attr_len;
        s->attr_len++;
        s->attr[i].gen = 0;
    }
    uint32_t g = s->attr[i].gen;
