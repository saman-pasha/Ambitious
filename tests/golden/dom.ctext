void dom_init(dom_document *d, uint32_t id) {
    if (d->node_len != 0) abort();
    d->id = id;
    d->revision = 0;
    text_add(d, "", 0);
    dom_node_h r = node_new(d);
    node_slot(d, r.index)->kind = DOM_NODE_KIND_DOCUMENT;
}
