%% build/schema/dom.pl -- the reasoning schema of dom, generated by tools/amb from contracts/dom.pl.
%% Do not edit: change the contract and run `make schema`.
dom_schema(module(dom,'0.1.0','fnv1a32:3c8be02d:6485')).
dom_schema(summary('Document Object Model: documents, elements, text, comments, attributes')).
dom_schema(handle(node,n)).
dom_schema(handle(attr,a)).
dom_schema(enum(node_kind,[document,doctype,element,text,comment])).
dom_schema(status([ok,stale_handle,wrong_kind,has_parent,not_a_child,would_cycle,invalid_name,not_found,out_of_memory])).
dom_schema(fact(dom_node/2,[handle(node),enum(node_kind)])).
dom_schema(fact(dom_element/2,[handle(node),atom])).
dom_schema(fact(dom_text/2,[handle(node),atom])).
dom_schema(fact(dom_comment/2,[handle(node),atom])).
dom_schema(fact(dom_doctype/2,[handle(node),atom])).
dom_schema(fact(dom_parent/2,[handle(node),handle_or_none(node)])).
dom_schema(fact(dom_next_sibling/2,[handle(node),handle_or_none(node)])).
dom_schema(fact(dom_first_child/2,[handle(node),handle_or_none(node)])).
dom_schema(fact(dom_attr/3,[handle_or_none(node),atom,atom])).
dom_schema(derived(dom_root/1,'the document node')).
dom_schema(derived(dom_child/2,'P is the parent of C')).
dom_schema(derived(dom_children/2,'the children of P, in order')).
dom_schema(derived(dom_ancestor/2,'A is an ancestor of D')).
dom_schema(derived(dom_descendant/2,'D is a descendant of A')).
dom_schema(derived(dom_inside/2,'N is inside the subtree of A (A itself included)')).
dom_schema(derived(dom_path/2,'the parent chain from the root to N')).
dom_schema(derived(dom_text_content/2,'the concatenated text of a subtree')).
dom_schema(derived(dom_accessible_name/2,'a control\'s accessible name, from aria-label, alt, title or content')).
dom_schema(derived(dom_missing_attribute/2,'an element lacks an attribute it requires')).
dom_schema(derived(dom_removal_effect/2,'what removing N takes with it')).
dom_schema(rules('rules/dom')).
dom_schema(operation(create_element,[text],handle(node),[mutates])).
dom_schema(operation(create_text,[text],handle(node),[mutates])).
dom_schema(operation(create_comment,[text],handle(node),[mutates])).
dom_schema(operation(create_doctype,[text,text,text,u8],handle(node),[mutates])).
dom_schema(operation(append_child,[handle(node),handle(node)],status,[mutates,requestable])).
dom_schema(operation(insert_before,[handle(node),handle(node),handle(node)],status,[mutates,requestable])).
dom_schema(operation(remove_child,[handle(node),handle(node)],status,[mutates,requestable])).
dom_schema(operation(destroy,[handle(node)],status,[mutates])).
dom_schema(operation(set_attribute,[handle(node),text,text],status,[mutates,requestable])).
dom_schema(operation(remove_attribute,[handle(node),text],status,[mutates,requestable])).
dom_schema(operation(set_data,[handle(node),text],status,[mutates,requestable])).
dom_schema(operation(serialize,[handle(node),stream],status,[readonly])).
dom_schema(query(buttons,(dom_element(A,button),dom_accessible_name(A,B)),[A,B],'every button and its accessible name')).
dom_schema(query(missing,dom_missing_attribute(A,B),[A,B],'elements that lack a required attribute')).
