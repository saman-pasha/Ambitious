static void store_script_store_tag__text_room(store_script_store_tag *s, size_t n) {
    if (s->text_len + n <= s->text_cap) return;
    size_t c = s->text_cap ? s->text_cap : 256;
    while (c < s->text_len + n) c *= 2;
    if (c > 0x7FFFFFFF) abort();
    s->text = (char *)realloc(s->text, c);
    if (!s->text) abort();
    s->text_cap = c;
}
amb_span store_script_store_tag_text_add(store_script_store_tag *s, const char *p, size_t n) {
    amb_span sp = { 0, 0 };
    if (s->text_len == 0) {
        store_script_store_tag__text_room(s, 1);
        s->text[0] = 0;
        s->text_len = 1;
    }
    if (n == 0) return sp;
    int inside = p >= s->text && p < s->text + s->text_len;
    size_t from = inside ? (size_t)(p - s->text) : 0;
    store_script_store_tag__text_room(s, n);
    if (inside) memmove(s->text + s->text_len, s->text + from, n);
    else memcpy(s->text + s->text_len, p, n);
    sp.off = (uint32_t)s->text_len;
    sp.len = (uint32_t)n;
    s->text_len += n;
    return sp;
}
