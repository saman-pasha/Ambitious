    s->definition[h.index].live = 0;
    s->definition[h.index].gen++;
    s->definition[h.index].free_next = s->definition_free;
    s->definition_free = h.index;
}
size_t store_script_store_tag_definition_len(const store_script_store_tag *s) { return s->definition_len; }
size_t store_script_store_tag_definition_count(const store_script_store_tag *s) {
    size_t n = 0;
    for (size_t i = 1; i < s->definition_len; i++) if (s->definition[i].live) n++;
    return n;
}
static void store_script_store_tag__text_room(store_script_store_tag *s, size_t n) {
    if (s->text_len + n <= s->text_cap) return;
    size_t c = s->text_cap ? s->text_cap : 256;
    while (c < s->text_len + n) c *= 2;
    if (c > 0x7FFFFFFF) abort();
    s->text = (char *)realloc(s->text, c);
    if (!s->text) abort();
    s->text_cap = c;
}
amb_span store_script_store_tag_text_add(store_script_store_tag *s, const char *p, size_t n) {
    amb_span sp = { 0, 0 };
    if (s->text_len == 0) {
        store_script_store_tag__text_room(s, 1);
        s->text[0] = 0;
        s->text_len = 1;
    }
    if (n == 0) return sp;
    int inside = p >= s->text && p < s->text + s->text_len;
    size_t from = inside ? (size_t)(p - s->text) : 0;
    store_script_store_tag__text_room(s, n);
    if (inside) memmove(s->text + s->text_len, s->text + from, n);
    else memcpy(s->text + s->text_len, p, n);
    sp.off = (uint32_t)s->text_len;
    sp.len = (uint32_t)n;
    s->text_len += n;
    return sp;
}
const char *store_script_store_tag_text_ptr(const store_script_store_tag *s, amb_span sp) tie s {
    if (s->text_len == 0 || (size_t)sp.off + sp.len > s->text_len) abort();
    return s->text + sp.off;
}
int store_script_store_tag_text_eq(const store_script_store_tag *s, amb_span sp, const char *p, size_t n) {
    if (sp.len != n) return 0;
    if (n == 0) return 1;
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    return memcmp(s->text + sp.off, p, n) == 0;
}
void store_script_store_tag_text_put(const store_script_store_tag *s, FILE *out, amb_span sp) {
    if (sp.len == 0) { amb_put_qatom(out, "", 0); return; }
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    amb_put_qatom(out, s->text + sp.off, sp.len);
}
size_t store_script_store_tag_text_size(const store_script_store_tag *s) { return s->text_len; }
