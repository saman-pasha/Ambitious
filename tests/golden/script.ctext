        if (1) { fputs("script_form_field(", out); { uint32_t r = d->form_field[i].navigation; amb_put_ref(out, "sn", d->id, r, r && r < d->navigation_len ? d->navigation[r].gen : 0); } fputs(",", out); text_put(d, out, d->form_field[i].name); fputs(",", out); amb_put_ref(out, "n", d->form_field[i].control.doc, d->form_field[i].control.index, d->form_field[i].control.gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->observer_len; i++) {
        if (!d->observer[i].live) continue;
        if (1) { fputs("script_observer(", out); amb_put_handle(out, "sm", d->id, i, d->observer[i].gen); fputs(",", out); { uint32_t r = d->observer[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(").\n", out); }
        if (d->observer[i].disconnected == 1) { fputs("script_observer_disconnected(", out); amb_put_handle(out, "sm", d->id, i, d->observer[i].gen); fputs(").\n", out); }
        if (1) { fputs("script_observer_delivered(", out); amb_put_handle(out, "sm", d->id, i, d->observer[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->observer[i].records); fputs(",", out); fprintf(out, "%lld", (long long)d->observer[i].calls); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->observation_len; i++) {
        if (!d->observation[i].live) continue;
        if (1) { fputs("script_observation(", out); amb_put_handle(out, "so", d->id, i, d->observation[i].gen); fputs(",", out); { uint32_t r = d->observation[i].observer; amb_put_ref(out, "sm", d->id, r, r && r < d->observer_len ? d->observer[r].gen : 0); } fputs(",", out); amb_put_ref(out, "n", d->observation[i].target.doc, d->observation[i].target.index, d->observation[i].target.gen); fputs(",", out); { uint32_t r = d->observation[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(").\n", out); }
        if (d->observation[i].child_list == 1) { fputs("script_observes_children(", out); amb_put_handle(out, "so", d->id, i, d->observation[i].gen); fputs(").\n", out); }
        if (d->observation[i].attributes == 1) { fputs("script_observes_attributes(", out); amb_put_handle(out, "so", d->id, i, d->observation[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->observation[i].filter); fputs(").\n", out); }
        if (d->observation[i].character_data == 1) { fputs("script_observes_data(", out); amb_put_handle(out, "so", d->id, i, d->observation[i].gen); fputs(").\n", out); }
        if (d->observation[i].subtree == 1) { fputs("script_observes_subtree(", out); amb_put_handle(out, "so", d->id, i, d->observation[i].gen); fputs(").\n", out); }
        if (d->observation[i].old_value == 1) { fputs("script_observes_old_values(", out); amb_put_handle(out, "so", d->id, i, d->observation[i].gen); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->definition_len; i++) {
        if (!d->definition[i].live) continue;
        if (1) { fputs("script_definition(", out); amb_put_handle(out, "sd", d->id, i, d->definition[i].gen); fputs(",", out); text_put(d, out, d->definition[i].name); fputs(",", out); { uint32_t r = d->definition[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(").\n", out); }
        if (1) { fputs("script_definition_observes(", out); amb_put_handle(out, "sd", d->id, i, d->definition[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->definition[i].observed); fputs(").\n", out); }
        if (1) { fputs("script_definition_upgraded(", out); amb_put_handle(out, "sd", d->id, i, d->definition[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->definition[i].upgraded); fputs(").\n", out); }
        if (d->definition[i].connected == 1) { fputs("script_defines_connected(", out); amb_put_handle(out, "sd", d->id, i, d->definition[i].gen); fputs(").\n", out); }
        if (d->definition[i].disconnected == 1) { fputs("script_defines_disconnected(", out); amb_put_handle(out, "sd", d->id, i, d->definition[i].gen); fputs(").\n", out); }
        if (d->definition[i].attribute_changed == 1) { fputs("script_defines_attribute_changed(", out); amb_put_handle(out, "sd", d->id, i, d->definition[i].gen); fputs(").\n", out); }
    }
}
script_status script_dispatch(script_runtime *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    script_status st = SCRIPT_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return SCRIPT_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return SCRIPT_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return SCRIPT_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return SCRIPT_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return SCRIPT_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return SCRIPT_STALE_REVISION; }

    amb_result(report, name, "bad_request", d->revision);
    return st;
}
/* the store of module script, an instance of store<script_store_tag>: one own buffer a part */
typedef struct store_script_store_tag {
    uint32_t id;
    uint64_t revision;
    size_t run_len, run_cap;
    uint32_t run_free;
    own script_run *run;
    size_t console_len, console_cap;
    uint32_t console_free;
    own script_console *console;
    size_t error_len, error_cap;
    uint32_t error_free;
    own script_error *error;
    size_t listener_len, listener_cap;
    uint32_t listener_free;
    own script_listener *listener;
    size_t timer_len, timer_cap;
    uint32_t timer_free;
    own script_timer *timer;
    size_t request_len, request_cap;
    uint32_t request_free;
    own script_request *request;
    size_t write_len, write_cap;
    uint32_t write_free;
    own script_write *write;
    size_t navigation_len, navigation_cap;
    uint32_t navigation_free;
    own script_navigation *navigation;
    size_t form_field_len, form_field_cap;
    uint32_t form_field_free;
    own script_form_field *form_field;
    size_t observer_len, observer_cap;
    uint32_t observer_free;
    own script_observer *observer;
    size_t observation_len, observation_cap;
    uint32_t observation_free;
    own script_observation *observation;
    size_t definition_len, definition_cap;
    uint32_t definition_free;
    own script_definition *definition;
    size_t text_len, text_cap;
    own char *text;
} store_script_store_tag;
void store_script_store_tag_drop(store_script_store_tag *s) { free(s->run); free(s->console); free(s->error); free(s->listener); free(s->timer); free(s->request); free(s->write); free(s->navigation); free(s->form_field); free(s->observer); free(s->observation); free(s->definition); free(s->text); }
static void store_script_store_tag__run_grow(store_script_store_tag *s) {
    size_t c = s->run_cap ? 2 * s->run_cap : 16;
    if (c > 0x7FFFFFFF) abort();
    s->run = (script_run *)realloc(s->run, c * sizeof(script_run));
    if (!s->run) abort();
    s->run_cap = c;
}
script_run_h store_script_store_tag_run_new(store_script_store_tag *s) {
    uint32_t i;
    if (s->run_free) {
        i = s->run_free;
        s->run_free = s->run[i].free_next;
    } else {
        if (s->run_len == 0) {
            if (s->run_cap == 0) store_script_store_tag__run_grow(s);
            memset(&s->run[0], 0, sizeof(script_run));
            s->run_len = 1;
        }
        if (s->run_len == s->run_cap) store_script_store_tag__run_grow(s);
        i = (uint32_t)s->run_len;
        s->run_len++;
        s->run[i].gen = 0;
    }
    uint32_t g = s->run[i].gen;
    memset(&s->run[i], 0, sizeof(script_run));
    s->run[i].gen = g;
    s->run[i].live = 1;
    script_run_h h = { s->id, i, g };
    return h;
}
int store_script_store_tag_run_live(const store_script_store_tag *s, script_run_h h) {
    return h.doc == s->id && h.index != 0 && h.index < s->run_len && s->run[h.index].live && s->run[h.index].gen == h.gen;
}
script_run store_script_store_tag_run_get(const store_script_store_tag *s, script_run_h h) {
    if (!store_script_store_tag_run_live(s, h)) abort();
    return s->run[h.index];
}
script_run *store_script_store_tag_run_ref(const store_script_store_tag *s, script_run_h h) tie s {
    if (!store_script_store_tag_run_live(s, h)) abort();
    return &s->run[h.index];
}
script_run *store_script_store_tag_run_slot(const store_script_store_tag *s, uint32_t i) tie s {
    if (i == 0 || i >= s->run_len) abort();
    return &s->run[i];
}
script_run_h store_script_store_tag_run_handle(const store_script_store_tag *s, uint32_t i) {
    script_run_h h = { 0, 0, 0 };
    if (i != 0 && i < s->run_len && s->run[i].live) {
        h.doc = s->id;
        h.index = i;
        h.gen = s->run[i].gen;
    }
    return h;
}
void store_script_store_tag_run_free(store_script_store_tag *s, script_run_h h) {
    if (!store_script_store_tag_run_live(s, h)) abort();
    s->run[h.index].live = 0;
    s->run[h.index].gen++;
    s->run[h.index].free_next = s->run_free;
    s->run_free = h.index;
}
size_t store_script_store_tag_run_len(const store_script_store_tag *s) { return s->run_len; }
size_t store_script_store_tag_run_count(const store_script_store_tag *s) {
    size_t n = 0;
    for (size_t i = 1; i < s->run_len; i++) if (s->run[i].live) n++;
    return n;
}
