    }
    for (uint32_t i = 1; i < d->console_len; i++) {
        if (!d->console[i].live) continue;
        if (1) { fputs("script_console(", out); { uint32_t r = d->console[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(",", out); fputs(script_level_name(d->console[i].level), out); fputs(",", out); text_put(d, out, d->console[i].text); fputs(").\n", out); }
