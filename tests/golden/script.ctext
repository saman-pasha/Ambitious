void script_init(script_runtime *d, uint32_t id) {
    if (d->run_len != 0) abort();
    d->id = id;
    d->revision = 0;
    text_add(d, "", 0);
}
uint64_t script_revision(const script_runtime *d) { return d->revision; }
int script_check_invariants(const script_runtime *d, FILE *report) {
    int bad = 0;
    /* live_links */
    {
        for (uint32_t i = 1; i < d->console_len; i++) {
            uint32_t r = d->console[i].run;
            if (d->console[i].live && r && (r >= d->run_len || !d->run[r].live)) { bad++; amb_report(report, "script", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->error_len; i++) {
            uint32_t r = d->error[i].run;
            if (d->error[i].live && r && (r >= d->run_len || !d->run[r].live)) { bad++; amb_report(report, "script", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->listener_len; i++) {
            uint32_t r = d->listener[i].run;
            if (d->listener[i].live && r && (r >= d->run_len || !d->run[r].live)) { bad++; amb_report(report, "script", "live_links", i); }
        }
        for (uint32_t i = 1; i < d->timer_len; i++) {
            uint32_t r = d->timer[i].run;
            if (d->timer[i].live && r && (r >= d->run_len || !d->run[r].live)) { bad++; amb_report(report, "script", "live_links", i); }
        }
    }
    return bad;
}
void script_export(const script_runtime *d, FILE *out) {
    fprintf(out, "amb_snapshot(script, %u, %llu, '%s').\n", (unsigned)d->id, (unsigned long long)d->revision, script_fingerprint);
    for (uint32_t i = 1; i < d->run_len; i++) {
        if (!d->run[i].live) continue;
        if (1) { fputs("script_run(", out); amb_put_handle(out, "sr", d->id, i, d->run[i].gen); fputs(",", out); amb_put_ref(out, "n", d->run[i].elem.doc, d->run[i].elem.index, d->run[i].elem.gen); fputs(",", out); fputs(script_source_name(d->run[i].source), out); fputs(",", out); fputs(script_outcome_name(d->run[i].outcome), out); fputs(").\n", out); }
        if (d->run[i].source == SCRIPT_SOURCE_EXTERNAL) { fputs("script_url(", out); amb_put_handle(out, "sr", d->id, i, d->run[i].gen); fputs(",", out); text_put(d, out, d->run[i].url); fputs(").\n", out); }
        if (d->run[i].layouts != 0) { fputs("script_forced_layout(", out); amb_put_handle(out, "sr", d->id, i, d->run[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->run[i].layouts); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->console_len; i++) {
        if (!d->console[i].live) continue;
        if (1) { fputs("script_console(", out); { uint32_t r = d->console[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(",", out); fputs(script_level_name(d->console[i].level), out); fputs(",", out); text_put(d, out, d->console[i].text); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->error_len; i++) {
        if (!d->error[i].live) continue;
        if (1) { fputs("script_error(", out); { uint32_t r = d->error[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(",", out); fputs(script_phase_name(d->error[i].phase), out); fputs(",", out); text_put(d, out, d->error[i].message); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->listener_len; i++) {
        if (!d->listener[i].live) continue;
        if (d->listener[i].on == SCRIPT_LISTEN_ON_NODE) { fputs("script_listener(", out); amb_put_ref(out, "n", d->listener[i].target.doc, d->listener[i].target.index, d->listener[i].target.gen); fputs(",", out); text_put(d, out, d->listener[i].type); fputs(",", out); { uint32_t r = d->listener[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(").\n", out); }
        if (d->listener[i].on == SCRIPT_LISTEN_ON_WINDOW) { fputs("script_window_listener(", out); text_put(d, out, d->listener[i].type); fputs(",", out); { uint32_t r = d->listener[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(").\n", out); }
        if (d->listener[i].capture == 1) { fputs("script_capture(", out); amb_put_ref(out, "n", d->listener[i].target.doc, d->listener[i].target.index, d->listener[i].target.gen); fputs(",", out); text_put(d, out, d->listener[i].type); fputs(").\n", out); }
    }
    for (uint32_t i = 1; i < d->timer_len; i++) {
        if (!d->timer[i].live) continue;
        if (1) { fputs("script_timer(", out); amb_put_handle(out, "st", d->id, i, d->timer[i].gen); fputs(",", out); fprintf(out, "%lld", (long long)d->timer[i].delay); fputs(",", out); fputs(d->timer[i].repeats ? "true" : "false", out); fputs(",", out); fputs(script_timer_state_name(d->timer[i].state), out); fputs(").\n", out); }
        if (1) { fputs("script_timer_of(", out); amb_put_handle(out, "st", d->id, i, d->timer[i].gen); fputs(",", out); { uint32_t r = d->timer[i].run; amb_put_ref(out, "sr", d->id, r, r && r < d->run_len ? d->run[r].gen : 0); } fputs(").\n", out); }
    }
}
script_status script_dispatch(script_runtime *d, const char *t, size_t n, uint64_t batch_rev, FILE *report) {
    size_t p = 0;
    char name[64];
    size_t name_len = 0;
    int64_t doc = 0;
    int64_t rev = 0;
    script_status st = SCRIPT_BAD_REQUEST;
    name[0] = 0;
    if (!amb_lex_word(t, n, &p, "amb_request") || !amb_lex_char(t, n, &p, '(')) return SCRIPT_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &doc) || !amb_lex_char(t, n, &p, ',')) return SCRIPT_BAD_REQUEST;
    if (!amb_lex_int(t, n, &p, &rev) || !amb_lex_char(t, n, &p, ',')) return SCRIPT_BAD_REQUEST;
    if (!amb_lex_name(t, n, &p, name, sizeof name, &name_len)) return SCRIPT_BAD_REQUEST;
    if (doc != (int64_t)d->id) { amb_result(report, name, "bad_request", d->revision); return SCRIPT_BAD_REQUEST; }
    if (rev != (int64_t)batch_rev) { amb_result(report, name, "stale_revision", d->revision); return SCRIPT_STALE_REVISION; }

    amb_result(report, name, "bad_request", d->revision);
    return st;
}
