int store_script_store_tag_text_eq(const store_script_store_tag *s, amb_span sp, const char *p, size_t n) {
    if (sp.len != n) return 0;
    if (n == 0) return 1;
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    return memcmp(s->text + sp.off, p, n) == 0;
}
void store_script_store_tag_text_put(const store_script_store_tag *s, FILE *out, amb_span sp) {
    if (sp.len == 0) { amb_put_qatom(out, "", 0); return; }
    if ((size_t)sp.off + sp.len > s->text_len) abort();
    amb_put_qatom(out, s->text + sp.off, sp.len);
}
