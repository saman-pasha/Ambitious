-- the heading that skips a level, proved:
== why a11y_heading_jump(A, From, To)
  a11y_heading_jump(ax(1,22,0),1,3)   because
    findall(A-B,a11y_heading(A,B),[ax(1,9,0)-1,ax(1,22,0)-3,ax(1,26,0)-2])   [test]
    a11y_rules_next([ax(1,9,0)-1,ax(1,22,0)-3,ax(1,26,0)-2],ax(1,22,0),1,3)   [rule]
    3>1+1   [test]
  
