CONNECT localhost:TLS
CONNECT localhost:TLS
CONNECT localhost:TLS
CONNECT localhost:TLS12
CONNECT 127.0.0.1:TLS
CONNECT localhost:PORT
-- no_proxy=localhost: localhost reached directly, the address through the proxy
CONNECT 127.0.0.1:TLS
-- a tunnel the proxy refuses:
R = rs(1,3,0), Why = 'the proxy answered HTTP/1.1 403 Forbidden', U = 'https://blocked.test/logo.png', O = proxy_refused
CONNECT localhost:TLS
CONNECT blocked.test:443
-- http_proxy: the page asked for in absolute form, with the proxy's credentials
R = rs(1,1,0), P = 'http://127.0.0.1:PROXY', U = 'http://localhost:HTTP2/elsewhere.html', O = ok
GET http://localhost:HTTP2/elsewhere.html as amb:s@fe
