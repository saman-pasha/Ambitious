amb_diag(form_cross_origin_http, sn(1,1,0), 'a form was submitted to http://localhost:PORT/echo/cross: another origin, over http:, so what it sends crosses the network unencrypted').
amb_diag(form_password_http, n(1,82,0), 'the password field pw was submitted to http://localhost:PORT/echo/cross over http:, unencrypted').
amb_diag(form_password_http, n(1,82,0), 'the password field pw was submitted to http://127.0.0.1:PORT/echo/form over http:, unencrypted').
