-- the diagnostics: what declares no encoding, what is malformed
enc-windows-1252: amb_diag(undeclared_encoding, 'windows-1252', 'the page declares no encoding and is not ASCII: it was decoded as windows-1252, the default (<meta charset> declares one)').
enc-utf-8-undeclared: amb_diag(undeclared_encoding, 'UTF-8', 'the page declares no encoding and is not ASCII: it was decoded as UTF-8, as the file\'s bytes suggest (<meta charset> declares one)').
enc-utf-8-errors: amb_diag(malformed_bytes, 'UTF-8', '7 byte sequence(s) are not UTF-8: each became U+FFFD').
enc-replacement: amb_diag(replaced_encoding, replacement, 'the page\'s encoding is one the Encoding standard replaces: its text is a single U+FFFD').
enc-shift_jis: none of the encoding's
enc-http-koi8-r: none of the encoding's
