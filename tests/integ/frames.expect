-- the frame that frames its own page twice over, and the frame that failed to load, as advise says them:
amb_diag(frame_blocked, fm(1,15,0), 'the frame of <iframe> did not load file://ROOT/tests/pages/frames-self.html: the page framed its own URL inside itself twice over (Chromium lets it once), or it has too many frames; it shows about:blank').
amb_diag(failed, rs(1,4,0), 'the document file://ROOT/tests/pages/frames-missing.html (asked for by <iframe>) failed: no_such_file').
amb_diag(frame_failed, fm(1,8,0), 'the frame of <iframe id="missing"> did not load file://ROOT/tests/pages/frames-missing.html (no_such_file): it shows nothing, as Chromium\'s error page draws nothing').
amb_diag(frame_sandboxed_scripts, fm(1,9,0), 'the frame of <iframe id="sandboxed"> (about:srcdoc) is sandboxed without allow-scripts: its scripts do not run').
-- why a frame failed:
net_frame_failed(fm(1,8,0),no_such_file)   because
  net_frame(fm(1,8,0),n(1,22,0),9,'file://ROOT/tests/pages/frames-missing.html',src,failed)   [fact]
  net_frame_fetch(fm(1,8,0),rs(1,4,0))   [fact]
  net_failed(rs(1,4,0),no_such_file)   because
    net_resource(rs(1,4,0),'file://ROOT/tests/pages/frames-missing.html',document,no_such_file,404,'',0)   [fact]
    no_such_file\==ok   [test]
    no_such_file=no_such_file   [test]

