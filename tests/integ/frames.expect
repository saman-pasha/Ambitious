the same 9 lines
-- frames over HTTP, of two origins (frames-http.html, served), against Chromium's:
the same 11 lines
-- the frames of the served page as facts: their iframes, URLs, sources and outcomes:
F = fm(1,1,0), I = n(1,10,0), D = 2, U = 'http://127.0.0.1:PORT/frames-http-child.html', S = src, O = loaded, Id = same
F = fm(1,2,0), I = n(1,12,0), D = 3, U = 'http://localhost:PORT/frames-http-child.html', S = src, O = loaded, Id = cross
F = fm(1,3,0), I = n(1,14,0), D = 4, U = 'http://127.0.0.1:PORT/status/404', S = src, O = loaded, Id = gone
F = fm(1,4,0), I = n(1,18,0), D = 5, U = 'http://127.0.0.1:PORT/frames-http-child.html?lazy', S = src, O = lazy, Id = lazy
-- and what the reasoner says of them:
amb_diag(failed, rs(1,4,0), 'the document http://127.0.0.1:PORT/status/404 (asked for by <iframe>) failed: http_error(404)').
amb_diag(frame_lazy, fm(1,4,0), 'the frame of <iframe id="lazy"> (http://127.0.0.1:PORT/frames-http-child.html?lazy) loads lazily and is out of the viewport\'s reach: not loaded at rest').
