R = rs(1,1,0), How = not_stored, Age = 0, Life = 0, U = 'https://localhost:CACHE/h2/c.html', S = 200
R = rs(1,2,0), How = fresh, Age = 61, Life = 3600, U = 'https://localhost:CACHE/h2/fresh.css', S = 200
