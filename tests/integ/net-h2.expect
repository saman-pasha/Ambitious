-- what each run's requests carried, as the server decoded them: the cookies (a field each, as Chromium splits them) and the validators
-- 1
GET /h2/c.html
GET /h2/fresh.css
  cookie: h2c=3
  cookie: h2a=1
  cookie: h2b=2
GET /h2/etag.css
  cookie: h2c=3
  cookie: h2a=1
  cookie: h2b=2
-- 2
GET /h2/c.html
  cookie: h2a=1
  cookie: h2b=2
GET /h2/etag.css
  if-none-match: "h2e"
  cookie: h2c=3
  cookie: h2a=1
  cookie: h2b=2
