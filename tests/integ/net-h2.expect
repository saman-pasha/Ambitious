6 connections, 13 requests
the page's connection carried parts after it
-- the page's request: a loopback host is potentially trustworthy (br and zstd, client hints, fetch metadata)
conn 1 request 1 GET /h2/k.html
  Host: 127.0.0.1:PLAIN
  Connection: keep-alive
  sec-ch-ua: "Ambitious";v="0"
  sec-ch-ua-mobile: ?0
  sec-ch-ua-platform: "Linux"
  Upgrade-Insecure-Requests: 1
  User-Agent: Ambitious/0.1
  Accept: text/html,application/xhtml+xml,application/xml;q=0.9,image/webp,image/apng,*/*;q=0.8
  Sec-Fetch-Site: none
  Sec-Fetch-Mode: navigate
  Sec-Fetch-User: ?1
  Sec-Fetch-Dest: document
  Accept-Encoding: gzip, deflate, br, zstd
