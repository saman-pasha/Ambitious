-- the window page's console, against Chromium's:
the same 60 lines
-- localStorage kept in a profile, twice; then a private session's:
visits 1, "tab\there\nand a newline \\ backslash", 2
visits 2, "tab\there\nand a newline \\ backslash", 2
visits 1, "tab\there\nand a newline \\ backslash", 2
-- history's navigations, as the reasoner has them:
N = sn(1,1,0), M = pushState, U = 'http://127.0.0.1:PORT/window.html?step=2#two'
N = sn(1,2,0), M = replaceState, U = 'http://127.0.0.1:PORT/window.html?step=3'
N = sn(1,3,0), M = pushState, U = 'http://127.0.0.1:PORT/window.html?step=3#frag'
-- the storage writes: their areas, what they did, their keys (no value):
S = ss(1,1,0), A = local, Op = set, K = a
S = ss(1,2,0), A = local, Op = set, K = b
S = ss(1,3,0), A = local, Op = set, K = c
S = ss(1,4,0), A = session, Op = set, K = a
S = ss(1,5,0), A = local, Op = set, K = a
S = ss(1,6,0), A = local, Op = remove, K = b
S = ss(1,7,0), A = local, Op = set, K = authToken
S = ss(1,8,0), A = local, Op = set, K = theme
S = ss(1,9,0), A = session, Op = clear, K = ''
S = ss(1,10,0), A = local, Op = clear, K = ''
-- what the reasoner says of them:
amb_diag(storage_credential, ss(1,7,0), 'the script #1 (inline) stored a value that looks like a credential in localStorage under authToken: every script of the origin can read it there (an HttpOnly cookie keeps it from scripts)').
