sheet: @charset "utf-8"; @import url("imp.css") screen; @namespace svg url(http://www.w3.org/2000/svg); .a { color: red; margin: 1px 2px; } div>p , span+em { background: blue !important; } @media (min-width: 100px) { .b { color: green } } @supports (display: grid) { .c { display: grid } } @container card (min-width: 400px) { .d { padding: 1em } } @layer base, theme; @layer base { .e { color: #FF0000 } } @font-face { font-family: "Foo"; src: url(foo.woff2) format("woff2"); font-weight: bold; } @keyframes spin { from { transform: rotate(0deg) } 50% { opacity: .5 } to { transform: rotate(360deg) } } @page :first { margin: 1in; } @property --x { syntax: '<length>'; inherits: false; initial-value: 0px; } @counter-style thumbs { system: cyclic; symbols: "X"; suffix: " "; } @scope (.card) to (.content) { img { border: 1px solid black } }
  0: @import url("imp.css") screen;
  1: @namespace svg url("http://www.w3.org/2000/svg");
  2: .a { color: red; margin: 1px 2px; }
  3: div > p, span + em { background: blue !important; }
  4: @media (min-width: 100px) {
  .b { color: green; }
}
  5: @supports (display: grid) {
  .c { display: grid; }
}
  6: @container card (min-width: 400px) {
  .d { padding: 1em; }
}
  7: @layer base, theme;
  8: @layer base {
  .e { color: rgb(255, 0, 0); }
}
  9: @font-face { font-family: Foo; src: url("foo.woff2") format("woff2"); font-weight: bold; }
  10: @keyframes spin { 
  0% { transform: rotate(0deg); }
  50% { opacity: 0.5; }
  100% { transform: rotate(360deg); }
}
  11: @page :first { margin: 1in; }
  12: @property --x { syntax: "<length>"; inherits: false; initial-value: 0px; }
  13: @counter-style thumbs { system: cyclic; symbols: "X"; suffix: " "; }
  14: @scope (.card) to (.content) {
  img { border: 1px solid black; }
}
sheet: @import url("imp.css") layer(base) supports(display: grid) screen and (min-width: 1px); @import "imp.css"; @import url(imp.css) layer; @namespace url(http://www.w3.org/1999/xhtml); @namespace svg url("http://www.w3.org/2000/svg"); .a { color: red; & .b { color: blue; } &:hover { color: green } .c & { margin: 0 } } @media screen and (min-width: 100px), print { .m { color: red } } @supports (display: grid) and (not (display: inline-grid)) { .s { color: red } } @container card (min-width: 400px) and (orientation: landscape) { .c { color: red } } @container (width > 10px) { .c2 { color: red } } @layer A.B, C; @layer D { .l { color: red } } @layer { .anon { color: red } } @keyframes Spin { 0% { opacity: 0 } 50%, 75% { opacity: .5 } TO { opacity: 1 } } @keyframes "quoted" { from { color: red } } @page { margin: 1cm } @page :left { margin-left: 2cm } @page wide:first { size: landscape } @property --len { syntax: "<length>"; inherits: true; initial-value: 10px } @property --any { syntax: "*"; inherits: false } @counter-style foo { system: fixed 3; symbols: a b c; suffix: ") "; prefix: "("; negative: "-"; range: 1 10; pad: 2 "0"; fallback: decimal; speak-as: numbers } @scope (.x) { .y { color: red } } @scope { .z { color: red } } @scope (.p) to (.q, .r) { .t { color: red } } @font-face { font-family: Bar; src: local(Arial), url(x.woff) format(woff); unicode-range: U+0000-00FF, U+0131; font-display: swap } @starting-style { .st { opacity: 0 } } @font-feature-values Foo { @styleset { nice: 2 } } @font-palette-values --pal { font-family: Bar; base-palette: 1 } @view-transition { navigation: auto } @position-try --top { top: anchor(bottom) }
  0: @import url("imp.css") layer(base) supports(display: grid) screen and (min-width: 1px);
  1: @import url("imp.css");
  2: @import url("imp.css") layer;
  3: @namespace url("http://www.w3.org/1999/xhtml");
  4: @namespace svg url("http://www.w3.org/2000/svg");
  5: .a {
  color: red;
  & .b { color: blue; }
  &:hover { color: green; }
  .c & { margin: 0px; }
}
  6: @media screen and (min-width: 100px), print {
  .m { color: red; }
}
  7: @supports (display: grid) and (not (display: inline-grid)) {
  .s { color: red; }
}
  8: @container card (min-width: 400px) and (orientation: landscape) {
  .c { color: red; }
}
  9: @container (width > 10px) {
  .c2 { color: red; }
}
  10: @layer A.B, C;
  11: @layer D {
  .l { color: red; }
}
  12: @layer {
  .anon { color: red; }
}
  13: @keyframes Spin { 
  0% { opacity: 0; }
  50%, 75% { opacity: 0.5; }
  100% { opacity: 1; }
}
  14: @keyframes quoted { 
  0% { color: red; }
}
  15: @page { margin: 1cm; }
  16: @page :left { margin-left: 2cm; }
  17: @page wide:first { size: landscape; }
  18: @property --len { syntax: "<length>"; inherits: true; initial-value: 10px; }
  19: @property --any { syntax: "*"; inherits: false; }
  20: @counter-style foo { system: fixed 3; symbols: a b c; negative: "-"; prefix: "("; suffix: ") "; pad: 2 "0"; range: 1 10; fallback: decimal; speak-as: numbers; }
  21: @scope (.x) {
  .y { color: red; }
}
  22: @scope {
  .z { color: red; }
}
  23: @scope (.p) to (.q, .r) {
  .t { color: red; }
}
  24: @font-face { font-family: Bar; src: local("Arial"), url("x.woff") format("woff"); unicode-range: U+0-FF, U+131; font-display: swap; }
  25: @starting-style {
  .st { opacity: 0; }
}
  26: @font-feature-values Foo { @styleset { nice: 2; } }
  27: @font-palette-values --pal { font-family: Bar; base-palette: 1; }
  28: @view-transition { navigation: auto; }
  29: @position-try --top { top: anchor(bottom); }
